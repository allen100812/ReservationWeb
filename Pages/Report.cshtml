@page
@model Web0524.Pages.ReportModel
@{
}
<!DOCTYPE html>
<meta charset="utf-8">
<html lang="en">
<head>
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/2.0.8/clipboard.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.min.js" integrity="sha384-Rx+T1VzGupg4BHQYs2gCW9It+akI2MM/mndMCy36UVfodzcJcF0GGLxZIzObiEfa" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/compressorjs/1.0.7/compressor.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>美容工作室介紹</title>
</head>
<body>
    <div class="container" style="margin-top:200px;">
        @Html.AntiForgeryToken()

        <h2 class="mb-4">報表查詢系統</h2>

        <div class="mb-3">
            <label for="reportType" class="form-label">選擇報表</label>
            <select id="reportType" class="form-select">
                <option value="">請選擇</option>
                <option value="reservationSummary">總預約統計</option>
                <option value="designerStats">設計師接單報表</option>
                <option value="peakHour">高峰時段分析</option>
                <option value="revenue">營收統計</option>
                <option value="designerRevenue">設計師營收報表</option>
                <option value="paymentMethod">支付方式分析</option>
                <option value="memberActivity">會員活躍度分析</option>
                <option value="pointUsage">點數使用分析</option>
                <option value="topMember">高貢獻會員排行</option>
                <option value="couponUsage">優惠券使用分析</option>
                <option value="reservationDetail">預約明細匯出</option>
            </select>
        </div>

        <div id="parameterSection">
            <div class="mb-3">
                <label for="startDate" class="form-label">起始日期</label>
                <input type="date" id="startDate" class="form-control">
            </div>
            <div class="mb-3">
                <label for="endDate" class="form-label">結束日期</label>
                <input type="date" id="endDate" class="form-control">
            </div>
            <div class="mb-3 d-none" id="designerFilter">
                <label for="designerId" class="form-label">設計師 ID</label>
                <input type="number" id="designerId" class="form-control">
            </div>
            <div class="mb-3 d-none" id="topNFilter">
                <label for="topN" class="form-label">前 N 名</label>
                <input type="number" id="topN" class="form-control" value="20">
            </div>
        </div>


        <div id="reportResult"></div>

        <button id="submitBtn" class="btn btn-primary">查詢報表</button>
    </div>

    <script>
        document.getElementById("submitBtn").addEventListener("click", async () => {
            const reportType = document.getElementById("reportType").value;
            const startDate = document.getElementById("startDate").value;
            const endDate = document.getElementById("endDate").value;
            const designerId = document.getElementById("designerId").value;
            const topN = document.getElementById("topN").value;

            const payload = new URLSearchParams();
            payload.append("ReportType", reportType);
            payload.append("StartDate", startDate);
            payload.append("EndDate", endDate);
            payload.append("DesignerId", designerId || "");
            payload.append("TopN", topN || "20");

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch("?handler=Ajax", {
                method: "POST",
                headers: {
                    "RequestVerificationToken": token,
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: payload
            });

            const result = await response.json();

            if (response.ok) {
                renderTable(result);
            } else {
                alert("查詢失敗");
            }
        });

        function renderTable(data) {
            const container = document.getElementById("reportResult");
            if (!data || data.length === 0) {
                container.innerHTML = "<div class='mt-4 alert alert-info'>查無資料</div>";
                return;
            }

            const keys = Object.keys(data[0]);
            let html = "<table class='table table-bordered mt-4'><thead><tr>";
            keys.forEach(key => html += `<th>${key}</th>`);
            html += "</tr></thead><tbody>";

            data.forEach(row => {
                html += "<tr>";
                keys.forEach(key => html += `<td>${row[key] ?? ""}</td>`);
                html += "</tr>";
            });

            html += "</tbody></table>";
            container.innerHTML = html;
        }
    </script>

</body>
</html>
