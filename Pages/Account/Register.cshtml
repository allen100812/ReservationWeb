@page
@model Web0524.Pages.Account.RegisterModel
@{
}
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["MyName"] | 會員登入</title>

    <!-- ChatGPT Style -->
    <link rel="stylesheet" href="/assets/root-DertGWcZ.css">
    <link rel="stylesheet" href="/assets/AuthStepLayout-D1Ycd_TU.css">
    <link rel="stylesheet" href="/assets/branding-D5M_DFHW.css">
    <link rel="stylesheet" href="/assets/Button-DEcOZt8f.css">
    <link rel="stylesheet" href="/assets/TextInput-DliBbVLE.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script type="text/javascript" src="https://auth.openai.com/sentinel/sdk.js" async defer></script>
    <style>
        body {
            background-color: #fff;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        }

        .form-container {
            max-width: 400px;
            margin: 80px auto;
        }

        .logo {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }

            .logo img {
                height: 40px;
            }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 20px 0;
        }

            .divider::before, .divider::after {
                content: "";
                flex: 1;
                border-bottom: 1px solid #dee2e6;
            }

            .divider:not(:empty)::before {
                margin-right: .75em;
            }

            .divider:not(:empty)::after {
                margin-left: .75em;
            }

        .btn-outline-secondary img {
            height: 20px;
            margin-right: 8px;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="form-container">
            <div class="logo text-center mb-3">
                <img src="~/dist/img/MyLogo.png" alt="My Logo">
            </div>

            <h4 class="text-center mb-2">立即加入會員</h4>
            <p class="text-center text-muted mb-4" style="font-size: 14px;">
                建議可使用 LINE 直接登入，我們將透過 LINE 傳送預約提醒與服務進度。
            </p>

            <!-- LINE 註冊按鈕 -->
            <div class="mb-3">
                <a href="/Account/Register?handler=LineRegister" class="btn btn-success w-100 mb-2">
                    <i class="fab fa-line"></i> <span class="m-2">使用 LINE 直接登入</span>
                </a>
            </div>

            <!-- 切換帳號註冊按鈕 -->
            <div class="mb-3">
                <button class="btn btn-outline-secondary w-100" type="button" id="toggle-manual-register">
                    <i class="fas fa-envelope text-primary"></i> <span class="m-2">使用 Email 註冊</span>
                </button>
            </div>

            <!-- 帳號註冊表單（預設隱藏） -->

            <div id="manual-register-form" style="display: none;">


                <!-- 註冊送出 -->
                <form method="post" asp-page-handler="Register">
                    <div class="mb-3">
                        <input asp-for="Register.UserName" class="form-control" placeholder="真實姓名">
                        <span asp-validation-for="Register.UserName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input asp-for="Register.Email" class="form-control" placeholder="電子郵件" id="emailInput">

                        <span asp-validation-for="Register.Email" class="text-danger"></span>
                    </div>

                    <!-- 驗證碼欄位與發送按鈕 -->
                    <div class="mb-3 d-flex">
                        <input asp-for="Register.VerificationCode" class="form-control me-2" placeholder="驗證碼">
                        <button id="sendCodeBtn" type="button" class="btn btn-outline-primary" @(Model.CountdownSeconds > 0 ? "disabled" : "")>
                            <span id="sendCodeText">@(Model.CountdownSeconds > 0 ? $"{Model.CountdownSeconds} 秒後可重發" : "發送驗證碼")</span>
                        </button>
                    </div>


                    <div class="mb-3">
                        <input asp-for="Register.Password" type="password" class="form-control" placeholder="密碼">
                        <span asp-validation-for="Register.Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input asp-for="Register.ConfirmPassword" type="password" class="form-control" placeholder="確認密碼">
                        <span asp-validation-for="Register.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2">註冊</button>
                </form>

                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-info mt-2">@Model.Message</div>
                }

            </div>



            <!-- 分隔線 -->
            <div class="divider text-center text-muted my-3">或</div>

            <!-- 回登入連結 -->
            <div class="text-center mb-3">
                <small>已經有帳號了？<a href="/Account/Login">立即登入</a></small>
            </div>

            <!-- JS 展開切換 -->
            <script>
                document.getElementById('toggle-manual-register').addEventListener('click', function () {
                    const form = document.getElementById('manual-register-form');
                    form.style.display = (form.style.display === 'none') ? 'block' : 'none';
                });
            </script>

        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    let cooldown = 0;
    let timer;

    function startCooldown(seconds) {
        cooldown = seconds;
        $("#sendCodeBtn").prop("disabled", true);
        updateCooldownText();

        timer = setInterval(() => {
            cooldown--;
            updateCooldownText();
            if (cooldown <= 0) {
                clearInterval(timer);
                $("#sendCodeBtn").prop("disabled", false);
                $("#cooldownText").text("");
            }
        }, 1000);
    }

    function updateCooldownText() {
        $("#cooldownText").text(`請稍候 ${cooldown} 秒再發送`);
    }

    $("#sendCodeBtn").click(function () {
        const email = $("#emailInput").val().trim();


        $.ajax({
            url: "/api/email/send",
            method: "POST",
            data: { email },
            success: function (res) {
                alert(res.message);
                startCooldown(60);
            },
            error: function (xhr) {
                alert("錯誤：" + xhr.responseText);
            }
        });
    });
</script>

</body>



</html>
