    @page
    @model Web0524.Pages.Management.NewsManagementModel
    @{
        ViewData["Title"] = "新聞管理";
        var tags = Enum.GetValues(typeof(Models.NewsTag)).Cast<Models.NewsTag>().ToList();
    }

    <!DOCTYPE html>
    <html lang="en">
    <head>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
        <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet">
        <link href="css/hover-min.css" rel="stylesheet">
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <link rel="stylesheet" href="~/css/Share.css">
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="~/js/responsivePaginator.js"></script>
    </head>
    <body>
    @Html.AntiForgeryToken()
        <div class="container" style="margin-top:200px; margin-bottom:200px;">
        
        <h2 class="mb-4 fw-bold">新聞管理</h2>

            <form id="newsForm" enctype="multipart/form-data">
                <input type="hidden" asp-for="NewItem.NewId" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">新聞標題</label>
                        <input asp-for="NewItem.Title" class="form-control" placeholder="請輸入新聞標題" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">作者</label>
                        <input asp-for="NewItem.Author" class="form-control" placeholder="請輸入作者名稱" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">新聞內容</label>
                    <textarea asp-for="NewItem.Content" class="form-control" rows="5" placeholder="請輸入新聞內容..."></textarea>
                </div>

            <div class="mb-3">
                <label class="form-label">相關連結（可選）</label>
                <input asp-for="NewItem.Link" class="form-control" placeholder="請輸入完整網址，如：https://example.com" />
            </div>

                <div class="row mb-3">
                    @{
                        var publishDateValue = Model.NewItem.PublishDate?.ToString("yyyy-MM-ddTHH:mm") ?? DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
                    }
                    <div class="col-md-4">
                        <label class="form-label">發布時間</label>
                        <input name="NewItem.PublishDate" class="form-control" type="datetime-local" value="@publishDateValue" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">狀態</label>
                        <select asp-for="NewItem.Status" class="form-select">
                            <option value="0">草稿</option>
                            <option value="1">已發布</option>
                            <option value="2">下架</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">標籤</label>
                        <select asp-for="NewItem.Tag" class="form-select">
                            <option value="">-- 請選擇標籤 --</option>
                            @foreach (var tag in tags)
                            {
                                <option value="@((int)tag)" selected="@(Model.NewItem.Tag == (int)tag)">@tag</option>
                            }
                        </select>
                    </div>
                </div>
<div class="col-md-4">
    <label class="form-label">是否置頂</label>
    <select class="form-select" id="TopOption">
        <option value="false">否</option>
        <option value="true">是</option>
    </select>
</div>


                <div class="mb-3">
                    <label class="form-label">上傳圖片（可複選）</label>
                    <input asp-for="NewItem.Photos" type="file" class="form-control" multiple />

                    <div id="existing-images" class="mt-3 row row-cols-2 row-cols-md-4 g-3">
                        @if (Model.NewItem.PhotoList?.Any() == true)
                        {
                            for (int i = 0; i < Model.NewItem.PhotoList.Count; i++)
                            {
                                var base64 = Convert.ToBase64String(Model.NewItem.PhotoList[i]);
                                var imgSrc = $"data:image/jpeg;base64,{base64}";
                                <div class="position-relative col">
                                    <img src="@imgSrc" class="img-thumbnail w-100" />
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 remove-photo-btn" data-index="@i" title="刪除圖片">✕</button>
                                </div>
                            }
                        }
                    </div>

                </div>
                <div class="mb-3">
                    <div class="row row-cols-2 row-cols-md-4 g-3" id="upload-preview"></div>

                </div>
            <div id="message-area"></div>
                <button type="submit" class="btn btn-dark">儲存新聞</button>
            </form>

            <hr />

            <div class="row g-3 align-items-center mb-4 mt-4">
                <div class="col-md-9">
                    <input type="text" id="searchInput" class="form-control" placeholder="搜尋標題 / 作者..." />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-dark w-100" id="searchBtn">查詢</button>
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table id="news-table" class="table table-bordered align-middle text-center w-100"></table>
            </div>
            <div id="news-accordion" class="accordion mb-4"></div>
            <div id="news-pagination" class="mb-4"></div>
        </div>

    </div>
    <script>
        // 對應 tag 數值 → 顯示文字
const tagEnumMap = {
    1: "新聞",
    2: "優惠",
    3: "活動",
    4: "公告",
    5: "重要"
};



        // 全局變數
        const allNews = @Html.Raw(Json.Serialize(Model.NewsList));
        let filteredNews = [...allNews];

        // 渲染分頁器：依 filteredNews 渲染桌機 Table 或手機手風琴格式
        function renderNewsTable() {
                filteredNews.sort((a, b) => {
        if (a.status === 2 && b.status !== 2) return 1;
        if (a.status !== 2 && b.status === 2) return -1;
        return new Date(b.publishDate) - new Date(a.publishDate);
    });

            window.initResponsivePaginator({
                data: filteredNews,
                tableColumns: [
                    {
                        title: '標題',
                        render: row => row.title,
                    },
                    {
                        title: '作者',
                        render: row => row.author,
                    },
                    {
                        title: '狀態',
                        className: 'text-nowrap',
                        render: row => {
                            const text = row.status === 0 ? '草稿' : row.status === 1 ? '已發布' : '下架';
                            const color = row.status === 0 ? 'text-muted' : row.status === 1 ? 'text-success' : 'text-danger';
                            return `<span class="${color}">${text}</span>`;
                        }
                    },
{
    title: '發布時間',
    render: row => formatDate(row.publishDate)
}
,
{
    title: '置頂',
    className: 'text-nowrap',
    render: row => {
        if (row.topTime) {
            const dt = formatDate(row.topTime);
            return `<span class="badge bg-warning text-dark">置頂</span>`;
        }
        return '';
    }
}
,
{
    title: '標籤',
    render: row => `<span class="badge bg-info">${tagEnumMap[row.tag] ?? ''}</span>`,
},
                    {
                        title: '連結',
                        render: row => row.link
                            ? `<a href="${row.link}" target="_blank" class="text-decoration-underline text-primary">前往</a>`
                            : '-'
                    },

{
    title: '是否下架',
    render: row => row.status === 2
        ? '<span class="badge bg-danger">已下架</span>'
        : '<span class="badge bg-success">未下架</span>'
}



                ],
                tableWrapperId: "news-table",
                accordionWrapperId: "news-accordion",
                paginationWrapperId: "news-pagination",
                pageSize: 10,
                renderRowButtons: row => `
                                <button class="btn btn-sm btn-secondary edit-btn" data-id="${row.newId}">編輯</button>
                        <button class="btn btn-sm btn-danger delete-btn" data-id="${row.newId}">下架</button>
                    `,
                accordionHeaderRender: row => row.title
            });
        }

        // 前端搜尋：搜尋標題或作者
        function applySearch() {
            const keyword = $("#searchInput").val().trim().toLowerCase();
            if (!keyword) {
                filteredNews = [...allNews];
            } else {
                filteredNews = allNews.filter(n =>
                    (n.title && n.title.toLowerCase().includes(keyword)) ||
                    (n.author && n.author.toLowerCase().includes(keyword))
                );
            }
            renderNewsTable();
        }
        function formatDate(dateStr) {
    if (!dateStr) return '';
    const dt = new Date(dateStr);
    const yyyy = dt.getFullYear();
    const MM = String(dt.getMonth() + 1).padStart(2, '0');
    const dd = String(dt.getDate()).padStart(2, '0');
    const HH = String(dt.getHours()).padStart(2, '0');
    const mm = String(dt.getMinutes()).padStart(2, '0');
    return `${yyyy}/${MM}/${dd} ${HH}:${mm}`;
}

        // 輔助函式：取得防偽標記
        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        // 輔助函式：顯示訊息
        function showMsg(msg, success) {
            const cls = success ? 'success' : 'danger';
            $('#message-area').html(`<div class="alert alert-${cls} mt-3">${msg}</div>`);
        }

        // 圖片上傳相關變數與事件
        let selectedFiles = [];
        let preservedOriginalIndexes = [];

        // 當圖片上傳 input (id="NewItem_Photos") 改變時的預覽
        $(document).on('change', '#NewItem_Photos', function () {
            const files = this.files;
            if (files && files.length > 0) {
                Array.from(files).forEach((file) => {
                    const reader = new FileReader();
                    const idx = selectedFiles.length;
                    selectedFiles.push(file);
                    reader.onload = function (e) {
                        const base64 = e.target.result;
                        const html = `
                                    <div class="position-relative col upload-preview-block" data-index="${idx}">
                                        <img src="${base64}" class="img-thumbnail w-100" />
                                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 remove-photo-btn" data-index="${idx}" title="刪除圖片">✕</button>
                                    </div>`;
                        $("#existing-images").append(html);
                    };
                    reader.readAsDataURL(file);
                });
            }
            this.value = null;
        });

        // 刪除圖片 (原圖和新圖)
        $(document).on('click', '.remove-photo-btn', function () {
            const index = $(this).data("index");
            const isOriginal = $(this).closest('.existing-photo').length > 0;
            if (isOriginal) {
                preservedOriginalIndexes = preservedOriginalIndexes.filter(i => i !== index);
            } else {
                selectedFiles[index] = null;
            }
            $(this).closest('.upload-preview-block, .existing-photo').remove();
        });

        // 表單送出：包含檔案與保留原圖索引
        $("#newsForm").submit(function (e) {
            e.preventDefault();
            let formData = new FormData(this);
            // 決定是否置頂
const topOption = $('#TopOption').val();
if (topOption === 'true') {
    const now = new Date();
    formData.append("NewItem.TopTime", now.toISOString());
} else {
    formData.append("NewItem.TopTime", ""); // 傳空代表取消置頂
}

            selectedFiles.forEach(file => {
                if (file) formData.append("NewItem.Photos", file);
            });

            preservedOriginalIndexes.forEach(idx => {
                formData.append("PreservedPhotoIndexes", idx);
            });

            $.ajax({
                url: '?handler=Save',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    'RequestVerificationToken': getToken()
                },
                success: function (res) {
                    showMsg(res.message, true);
                    setTimeout(() => location.reload(), 1000);
                },
                error: function () {
                    showMsg("儲存失敗，請再試一次。", false);
                }
            });
        });

        // 委派事件：下架
        $(document).on('click', '.delete-btn', function () {
            if (!confirm("確認下架？")) return;
            const id = $(this).data("id");
            $.ajax({
                url: `?handler=ToggleStatus&id=${id}&status=2`,
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                success: function (res) {
                    showMsg(res.message, true);
                    setTimeout(() => location.reload(), 1000);
                },
                error: function () {
                    showMsg("下架失敗", false);
                }
            });
        });

        // 委派事件：編輯
        $(document).on('click', '.edit-btn', function () {
    const id = $(this).data("id");

    $.ajax({
        url: `?handler=Edit&id=${id}`,
        method: 'POST',
        headers: { 'RequestVerificationToken': getToken() },
        success: function (res) {
            if (res.success && res.data) {
                const n = res.data;
                console.log(n);

                // 清除已選圖片與原圖記錄
                selectedFiles = [];
                preservedOriginalIndexes = [];

                // 填入表單欄位
                $("#NewItem_NewId").val(n.newId);
                $("#NewItem_Title").val(n.title);
                $("#NewItem_Author").val(n.author);
                $("#NewItem_Content").val(n.content);
                $("#NewItem_PublishDate").val(n.publishDate);
                $("#NewItem_Status").val(n.status);
                $("#NewItem_Tag").val(n.tag);
                $("#TopOption").val(n.topTime ? 'true' : 'false');
                        $("#NewItem_Link").val(n.link);


                // 清除舊圖片區域
                $("#existing-images").empty();

                // 顯示已儲存的圖片（原圖）
                if (n.photoList?.length > 0) {
                    n.photoList.forEach((b64, i) => {
                        preservedOriginalIndexes.push(i);
                        $("#existing-images").append(`
                            <div class="position-relative col existing-photo" data-index="${i}">
                                <img src="data:image/jpeg;base64,${b64}" class="img-thumbnail w-100" />
                                <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 remove-photo-btn" data-index="${i}" title="刪除圖片">✕</button>
                            </div>
                        `);
                    });
                }

                // 捲動到最上方
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                showMsg("讀取失敗", false);
            }
        },
        error: function () {
            showMsg("編輯載入失敗", false);
        }
    });
});


        // 綁定查詢事件（搜尋區按鈕與按 Enter）
        $(document).ready(function () {
            // 初始顯示全部新聞
            renderNewsTable();

            $("#searchBtn").on("click", applySearch);
            $("#searchInput").on("keypress", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    applySearch();
                }
            });
        });
    </script>




        </body>
    </html>
