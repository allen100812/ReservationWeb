                background: rgba(255, 245, 250, 0.85); /* 粉白玻璃感 */
                border-radius: 16px;
                border: 1px solid rgba(255, 192, 203, 0.4);
                box-shadow: 0 8px 24px rgba(255, 105, 180, 0.2);
                backdrop-filter: blur(10px);
            }

            /* 頁首風格 */
            #messageModal .modal-header {
                background: linear-gradient(to right, #ffe6f0, #fff5fa);
                border-bottom: 1px solid #f8d8e4;
                border-top-left-radius: 16px;
                border-top-right-radius: 16px;
            }

            /* 標題文字 */
            #messageModal .modal-title {
                font-weight: 600;
                font-size: 1.25rem;
                color: #a32060;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            /* 關閉按鈕 */
            #messageModal .btn-close {
                filter: brightness(0.8);
            }

            /* 訊息列表樣式 */
            #messageList .list-group-item {
                border: none;
                background-color: #fff8fb;
                border-left: 4px solid #ffc0cb;
                margin-bottom: 10px;
                border-radius: 8px;
                box-shadow: 0 2px 6px rgba(255, 105, 180, 0.1);
                transition: background-color 0.3s;
            }

                #messageList .list-group-item:hover {
                    background-color: #fff0f5;
                }

        </style>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                document.querySelectorAll(".btn-toggle").forEach(btn => {
                    btn.addEventListener("click", () => {
                        const targetId = btn.getAttribute("data-target");
                        const targetEl = document.querySelector(targetId);

                        document.querySelectorAll(".submenu").forEach(menu => {
                            if (menu !== targetEl) {
                                menu.classList.add("collapse");
                            }
                        });

                        if (targetEl) {
                            targetEl.classList.toggle("collapse");
                        }
                    });
                });
            });

        </script>




