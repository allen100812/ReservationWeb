@page
@model Web0524.Pages.Management.UserManagementModel
@{
    ViewData["Title"] = "用戶管理";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet" media="all">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            background-color: #f8f9fa;
            color: #212529;
            font-family: "Segoe UI", sans-serif;
        }


        h2 {
            font-weight: bold;
            margin-bottom: 1.5rem;
        }

        table {
            background-color: #fff;
        }

        .form-control,
        .btn {
            border-radius: 6px;
        }

        .btn-sm {
            padding: 0.3rem 0.6rem;
            font-size: 0.85rem;
        }
        /* 統一按鈕大小 */
.action-buttons .action-btn {
    min-width: 100px;
}

/* 手機版：按鈕改為直排 + 滿版 */
@@media (max-width: 768px) {
    .action-buttons {
        flex-direction: column;
    }

    .action-buttons .action-btn {
        width: 100%;
    }
}

        .accordion-button:not(.collapsed) {
            background-color: #e2e6ea;
        }

        .accordion-body .form-control-sm {
            max-width: 300px;
        }
        @@media (max-width: 768px) {
            .table thead {
                display: none;
            }

            .table tbody tr {
                display: block;
                margin-bottom: 1rem;
                background: #fff;
                border: 1px solid #dee2e6;
                padding: 1rem;
                border-radius: 8px;
            }

            .table tbody td {
                display: flex;
                justify-content: space-between;
                padding: 0.4rem 0;
                border: none;
            }

            .table tbody td::before {
                content: attr(data-label);
                font-weight: bold;
                color: #6c757d;
            }

            .btn {
                width: 100%;
                margin-bottom: 0.5rem;
            }
        }
    </style>



</head>
<body>
    @Html.AntiForgeryToken()
    <!-- 編輯會員 Modal -->
    <div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form class="modal-content" id="editUserForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">編輯會員資料</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="edit-id">
                    <div class="mb-2">
                        <label for="edit-name">姓名</label>
                        <input type="text" class="form-control" id="edit-name" required>
                    </div>
                    <div class="mb-2">
                        <label for="edit-email">Email</label>
                        <input type="email" class="form-control" id="edit-email" required>
                    </div>
                    <div class="mb-2">
                        <label for="edit-phone">電話</label>
                        <input type="text" class="form-control" id="edit-phone">
                    </div>
                    <div class="mb-2">
                        <label for="edit-role">角色</label>
                        <select class="form-select" id="edit-role"></select>
                    </div>
                    <div class="mb-2">
                        <label for="edit-permission">權限</label>
                        <select class="form-select" id="edit-permission"></select>
                    </div>
                    <div class="mb-2">
                        <label for="edit-remark">備註</label>
                        <textarea class="form-control" id="edit-remark"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">儲存變更</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                </div>
            </form>
        </div>
    </div>

    <div class="container" style="margin-top:200px; margin-bottom:200px; ">
        <div id="message-area"></div>
        <h2 class="mb-4 fw-bold">用戶管理</h2>

        <!-- 篩選區 -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <input type="text" id="keyword" class="form-control" placeholder="輸入姓名、Email、電話">
            </div>
            <div class="col-md-2">
                <select class="form-select" id="filterRole">
                    <option value="">全部角色</option>
                    <option value="Developer">開發者</option>
                    <option value="SuperAdmin">超級管理員</option>
                    <option value="Admin">管理員</option>
                    <option value="Editor">編輯者</option>
                    <option value="VipMember">尊榮會員</option>
                    <option value="Member">一般會員</option>
                </select>
            </div>

            <div class="col-md-2">
                <select class="form-select" id="filterPermission">
                    <option value="">全部權限</option>
                    <option value="P1">P1</option>
                    <option value="P2">P2</option>
                    <option value="P3">P3</option>
                    <option value="P4">P4</option>
                    <option value="P5">P5</option>
                </select>
            </div>

            <div class="col-md-2">
                <select class="form-select" id="filterSource">
                    <option value="">全部來源</option>
                    <option value="Email">Email</option>
                    <option value="Line">Line</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="filterDeleted">
                    <option value="">是否停權</option>
                    <option value="false">未停權</option>
                    <option value="true">已停權</option>
                </select>
            </div>
        </div>

        <div class="mb-2"><strong>會員總數：</strong><span id="totalCount">0</span> 位</div>
        <div class="table-responsive mb-3">
            <table class="table table-bordered text-center align-middle" id="user-table"></table>
        </div>
        <div class="accordion" id="user-accordion"></div>
        <div id="user-pagination" class="mt-4"></div>
    </div>
    <script>
        let allUsers = [];
        const payload = {
            id: $('#edit-id').val(),
            name: $('#edit-name').val(),
            email: $('#edit-email').val(),
            phone: $('#edit-phone').val(),
            role: parseInt($('#edit-role').val()),
            permission: parseInt($('#edit-permission').val()),
            remark: $('#edit-remark').val()
        };
        const roleEnumMap = {
            0: '開發者',
            1: '超級管理員',
            2: '管理員',
            3: '編輯者',
            4: '尊榮會員',
            5: '一般會員'
        };

        const permissionEnumMap = {
            1: 'P1',
            2: 'P2',
            3: 'P3',
            4: 'P4',
            5: 'P5'
        };


        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function showMsg(msg, success) {
            const cls = success ? 'success' : 'danger';
            $('#message-area').html(`<div class="alert alert-${cls}">${msg}</div>`);
        }

        function loadUsers() {
            $.ajax({
                url: '/Management/UserManagement?handler=List',
                method: 'GET',
                headers: { 'RequestVerificationToken': getToken() },
                success: function (res) {
                    allUsers = res.users;
                    window.currentUserRole = res.currentRole;
                    renderFiltered();
                },
                error: () => showMsg('讀取用戶失敗', false)
            });
        }


        function renderFiltered() {
            const keyword = $('#keyword').val()?.toLowerCase();
            const role = $('#filterRole').val();
            const permission = $('#filterPermission').val();
            const source = $('#filterSource').val();
            const deleted = $('#filterDeleted').val();

            const filtered = allUsers.filter(u => {
                const kw = !keyword || [u.name, u.email, u.phone].some(x => x?.toLowerCase().includes(keyword));
                const r = !role || u.role === role;
                const p = !permission || u.permission === permission;
                const s = !source || u.userType === source;
                const d = deleted === '' || u.isDeleted.toString() === deleted;
                return kw && r && p && s && d;
            });

            $('#totalCount').text(filtered.length);
            renderPaginator(filtered);
        }

        function renderPaginator(data) {
            const columns = [
                { title: '帳號', className: 'text-nowrap', render: u => u.id },
                { title: '姓名', className: 'text-nowrap', render: u => u.name },
                { title: 'Email', className: 'text-nowrap', render: u => u.email },
                { title: '電話', className: 'text-nowrap', render: u => u.phone },
                { title: '訂單', className: 'text-nowrap', render: u => u.orderNum },
                { title: '取消', className: 'text-nowrap', render: u => u.cancelNum },
                {
                    title: '角色',
                    className: 'text-nowrap',
                    render: u => roleEnumMap?.[u.roleValue] || u.role
                },
                {
                    title: '權限',
                    className: 'text-nowrap',
                    render: u => permissionEnumMap?.[u.permissionValue] || u.permission
                },
                { title: '來源', className: 'text-nowrap', render: u => u.userType },
                { title: '停權', className: 'text-nowrap', render: u => u.isDeleted ? '是' : '否' },
                {
                    title: '備註',
                    className: 'text-nowrap',
                    render: u => u.remark || ''
                }

            ];



            window.initResponsivePaginator({
                data,
                tableColumns: columns,
                tableWrapperId: 'user-table',
                accordionWrapperId: 'user-accordion',
                paginationWrapperId: 'user-pagination',
                pageSize: 10,
                accordionHeaderRender: u => `<strong>${u.id}</strong> / ${u.name}`,
                renderRowButtons: u => {
                    const disabled = u.roleValue <= currentUserRole;
                    const jsonStr = JSON.stringify(u).replace(/'/g, "\\'");
                    return `
                <div class="d-inline-flex gap-1 text-nowrap">
                    <button class="btn btn-sm btn-primary" onclick='openEditModal(${jsonStr})' ${disabled ? 'disabled' : ''}>編輯</button>
                    <button class="btn btn-sm btn-secondary" onclick="resetPassword('${u.id}')" ${disabled ? 'disabled' : ''}>改密碼</button>
                    <button class="btn btn-sm ${u.isDeleted ? 'btn-success' : 'btn-danger'}"
                        onclick="${u.isDeleted ? `enableUser('${u.id}')` : `disableUser('${u.id}')`}" ${disabled ? 'disabled' : ''}>
                        ${u.isDeleted ? '啟用' : '停權'}
                    </button>
                </div>`;
                }

            });
        }

        function updateRemark(id, remark) {
            $.post('/Management/UserManagement?handler=UpdateRemark', { id, remark }, res => {
                showMsg(res.message, res.success);
            }).fail(() => showMsg('更新備註失敗', false));
        }

        function resetPassword(id) {
            const pwd = prompt("輸入新密碼（至少8位英數混合）:");
            if (!pwd || pwd.length < 8) return;
            $.post('/Management/UserManagement?handler=ResetPassword', { id, pwd }, res => {
                showMsg(res.message, res.success);
            }).fail(() => showMsg('密碼更新失敗', false));
        }

        function disableUser(id) {
            if (!confirm("確認停權此用戶？")) return;
            $.post('/Management/UserManagement?handler=DisableUser', { id }, res => {
                showMsg(res.message, res.success);
                loadUsers();
            }).fail(() => showMsg('停權失敗', false));
        }

        function enableUser(id) {
            if (!confirm("確認啟用此用戶？")) return;
            $.post('/Management/UserManagement?handler=EnableUser', { id }, res => {
                showMsg(res.message, res.success);
                loadUsers();
            }).fail(() => showMsg('啟用失敗', false));
        }

        $(document).ready(function () {
            loadUsers();
            ['#keyword', '#filterRole', '#filterPermission', '#filterSource', '#filterDeleted'].forEach(sel =>
                $(document).on('change keyup', sel, renderFiltered)
            );
        });
        
        function openEditModal(user) {
            $('#edit-id').val(user.id);
            $('#edit-name').val(user.name);
            $('#edit-email').val(user.email);
            $('#edit-phone').val(user.phone);
            $('#edit-remark').val(user.remark);

            // 角色下拉
            const roleSelect = $('#edit-role').empty();
            for (const [val, name] of Object.entries(roleEnumMap)) {
                roleSelect.append(`<option value="${val}" ${user.roleValue == val ? 'selected' : ''}>${name}</option>`);
            }

            // 權限下拉
            const permSelect = $('#edit-permission').empty();
            for (const [val, name] of Object.entries(permissionEnumMap)) {
                permSelect.append(`<option value="${val}" ${user.permissionValue == val ? 'selected' : ''}>${name}</option>`);
            }

            const modal = new bootstrap.Modal(document.getElementById('editUserModal'));
            modal.show();
        }
        // 提交表單儲存會員資料
        $('#editUserForm').on('submit', function (e) {
            e.preventDefault();

            const payload = {
                id: $('#edit-id').val(),
                name: $('#edit-name').val(),
                email: $('#edit-email').val(),
                phone: $('#edit-phone').val(),
                role: parseInt($('#edit-role').val()),
                permission: parseInt($('#edit-permission').val()),
                remark: $('#edit-remark').val()
            };

            $.ajax({
                url: '/Management/UserManagement?handler=EditUser',
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                data: payload,
                success: function (res) {
                    showMsg(res.message, res.success);
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('editUserModal')).hide();
                        loadUsers();
                    }
                },
                error: function () {
                    showMsg('儲存失敗', false);
                }
            });
        });

    </script>

    <script src="~/js/responsivePaginator.js"></script>
</body>
</html>
