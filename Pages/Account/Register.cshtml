@page
@model Web0524.Pages.Account.RegisterModel
@{
}
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["MyName"] | 會員登入</title>

    <!-- ChatGPT Style -->
    <link rel="stylesheet" href="/assets/root-DertGWcZ.css">
    <link rel="stylesheet" href="/assets/AuthStepLayout-D1Ycd_TU.css">
    <link rel="stylesheet" href="/assets/branding-D5M_DFHW.css">
    <link rel="stylesheet" href="/assets/Button-DEcOZt8f.css">
    <link rel="stylesheet" href="/assets/TextInput-DliBbVLE.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script type="text/javascript" src="https://auth.openai.com/sentinel/sdk.js" async defer></script>
    <style>
        body {
            background-color: #fff;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        }

        .form-container {
            max-width: 400px;
            margin: 80px auto;
        }

        .logo {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }

            .logo img {
                height: 40px;
            }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 20px 0;
        }

            .divider::before, .divider::after {
                content: "";
                flex: 1;
                border-bottom: 1px solid #dee2e6;
            }

            .divider:not(:empty)::before {
                margin-right: .75em;
            }

            .divider:not(:empty)::after {
                margin-left: .75em;
            }

        .btn-outline-secondary img {
            height: 20px;
            margin-right: 8px;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="form-container">
            <div class="logo text-center mb-3">
                <img src="~/dist/img/MyLogo.png" alt="My Logo">
            </div>

            <h4 class="text-center mb-2">立即加入會員</h4>
            <p class="text-center text-muted mb-4" style="font-size: 14px;">
                建議可使用 LINE 直接登入，我們將透過 LINE 傳送預約提醒與服務進度。
            </p>

            <!-- LINE 註冊按鈕 -->
            <div class="mb-3">
                <a href="/Account/Register?handler=LineRegister" class="btn btn-success w-100 mb-2">
                    <i class="fab fa-line"></i> <span class="m-2">使用 LINE 直接登入</span>
                </a>
            </div>

            <!-- 切換帳號註冊按鈕 -->
            <div class="mb-3">
                <button class="btn btn-outline-secondary w-100" type="button" id="toggle-manual-register">
                    <i class="fas fa-envelope text-primary"></i> <span class="m-2">使用 Email 註冊</span>
                </button>
            </div>

            <!-- 帳號註冊表單（預設隱藏） -->

            <div id="manual-register-form" style="display: none;">


                <!-- 註冊送出 -->
                <form method="post" action="?handler=RegisterJson" id="register-form">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <input asp-for="Register.UserName" class="form-control" placeholder="真實姓名">
                        <span asp-validation-for="Register.UserName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input asp-for="Register.Email" class="form-control" placeholder="電子郵件" id="emailInput">

                        <span asp-validation-for="Register.Email" class="text-danger"></span>
                    </div>

                    <!-- 驗證碼欄位與發送按鈕 -->
                    <div class="mb-3 d-flex">
                        <input asp-for="Register.VerificationCode" class="form-control me-2" placeholder="驗證碼">
                        <button id="sendCodeBtn" type="button" class="btn btn-outline-primary" @(Model.CountdownSeconds > 0 ? "disabled" : "")>
                            <span id="sendCodeText">@(Model.CountdownSeconds > 0 ? $"{Model.CountdownSeconds} 秒後可重發" : "發送驗證碼")</span>
                        </button>
                    </div>

                    <!-- 新增驗證碼訊息區塊 -->
                    <div id="code-message-area" class="mb-3"></div>

                    <div class="mb-3">
                        <input asp-for="Register.Password" type="password" class="form-control" placeholder="密碼">
                        <span asp-validation-for="Register.Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input asp-for="Register.ConfirmPassword" type="password" class="form-control" placeholder="確認密碼">
                        <span asp-validation-for="Register.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2">註冊</button>

                    <div class="mb-3">
                        <div id="register-result-message" class="mt-2"></div>


                        @if (!string.IsNullOrEmpty(Model.Message))
                        {
                            <script>
                                let countdown = 5;
                                const msg = document.getElementById("success-message");
                                const timer = setInterval(() => {
                                    countdown--;
                                    msg.innerText = "註冊成功！" + countdown + " 秒後將跳轉首頁...";
                                    if (countdown <= 0) {
                                        clearInterval(timer);
                                        window.location.href = "/Index";
                                    }
                                }, 1000);
                            </script>
                        }

                    </div>
                    <!-- 顯示後端錯誤或成功訊息 -->


                </form>

                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-info mt-2">@Model.Message</div>
                }

            </div>



            <!-- 分隔線 -->
            <div class="divider text-center text-muted my-3">或</div>

            <!-- 回登入連結 -->
            <div class="text-center mb-3">
                <small>已經有帳號了？<a href="/Account/Login">立即登入</a></small>
            </div>

            <!-- JS 展開切換 -->
            <script>
                document.getElementById('toggle-manual-register').addEventListener('click', function () {
                    const form = document.getElementById('manual-register-form');
                    form.style.display = (form.style.display === 'none') ? 'block' : 'none';
                });
            </script>

        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $("#register-form").submit(function (e) {
            e.preventDefault();

            // 取得欄位值
            const name = $("input[name='Register.UserName']").val().trim();
            const email = $("input[name='Register.Email']").val().trim();
            const code = $("input[name='Register.VerificationCode']").val().trim();
            const pwd = $("input[name='Register.Password']").val();
            const confirm = $("input[name='Register.ConfirmPassword']").val();

            let errors = [];

            // 驗證邏輯
            if (name === "") errors.push("請輸入真實姓名。");
            if (email === "") errors.push("請輸入電子郵件。");
            if (code === "") errors.push("請輸入驗證碼。");
            if (pwd === "") errors.push("請輸入密碼。");
            if (confirm === "") errors.push("請輸入確認密碼。");

            // ✅ 密碼格式驗證（至少8碼，含英文字母與數字）
            const passwordRegex = /^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]{8,}$/;
            if (pwd && !passwordRegex.test(pwd)) {
                errors.push("密碼需為至少8位英數混合。");
            }

            if (pwd && confirm && pwd !== confirm) {
                errors.push("密碼與確認密碼不一致。");
            }

            // 如果有錯誤，顯示並中斷
            if (errors.length > 0) {
                const errorHtml = errors.map(e => `<div>${e}</div>`).join('');
                $("#register-result-message").html(`<div class="alert alert-danger">${errorHtml}</div>`);
                return;
            }

            // ✅ 所有檢查通過再送出
            const formData = $(this).serialize();

            $.ajax({
                url: "/Account/Register?handler=RegisterJson",
                type: "POST",
                data: formData,
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    $("#register-result-message").empty();

                    if (res.success) {
                        $("#register-result-message").html(
                            `<div class="alert alert-success">註冊成功！<span id="countdown">3</span> 秒後跳轉首頁...</div>`
                        );
                        let seconds = 3;
                        const countdown = setInterval(() => {
                            seconds--;
                            $("#countdown").text(seconds);
                            if (seconds <= 0) {
                                clearInterval(countdown);
                                window.location.href = "/Index";
                            }
                        }, 1000);
                    } else {
                        if (Array.isArray(res.message)) {
                            const list = res.message.map(m => `<div>${m}</div>`).join('');
                            $("#register-result-message").html(`<div class="alert alert-danger">${list}</div>`);
                        } else {
                            $("#register-result-message").html(
                                `<div class="alert alert-danger">${res.message}</div>`
                            );
                        }
                    }
                },
                error: function () {
                    $("#register-result-message").html(
                        `<div class="alert alert-danger">發生未知錯誤，請稍後再試。</div>`
                    );
                }
            });
        });

</script>



    <script>
        let cooldown = 0;
        let timer;

        function startCooldown(seconds) {
            const email = $("#emailInput").val().trim();
            const targetTime = Date.now() + seconds * 1000;

            localStorage.setItem(`cooldown_end_${email}`, targetTime.toString());

            $("#sendCodeBtn").prop("disabled", true);

            clearInterval(timer);
            timer = setInterval(() => {
                const now = Date.now();
                const remaining = Math.floor((targetTime - now) / 1000);

                if (remaining > 0) {
                    $("#sendCodeText").text(`${remaining} 秒後可重發`);
                } else {
                    clearInterval(timer);
                    localStorage.removeItem(`cooldown_end_${email}`);
                    $("#sendCodeBtn").prop("disabled", false);
                    $("#sendCodeText").text("發送驗證碼");
                }
            }, 1000);
        }


        function updateCooldownText() {
            $("#sendCodeText").text(`${cooldown} 秒後可重發`);
        }

        function showBootstrapMessage(target, message, type = 'success') {
            const html = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
                            ${message}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>`;
            $(target).html(html);
        }

        $(document).off("click", "#sendCodeBtn").on("click", "#sendCodeBtn", function () {


            const email = $("#emailInput").val().trim();
            if (!email) {
                showBootstrapMessage("#code-message-area", "請先輸入電子郵件", "danger");
                return;
            }
            const lastSentTime = localStorage.getItem(`lastSent_${email}`);
            const now = Date.now();

            if (lastSentTime && now - parseInt(lastSentTime) < 60000) {
                showBootstrapMessage("#code-message-area", "已發送過，請稍後再試", "danger");
                return;
            }

            localStorage.setItem(`lastSent_${email}`, now.toString());
            startCooldown(60);
            $.ajax({
                url: "/Account/Register?handler=SendCode",
                type: "POST",
                data: {
                    email: $("#emailInput").val()
                },
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    if (res.success) {
                        showBootstrapMessage("#code-message-area", res.message, "success");
                        startCooldown(res.countdown || 60);
                    } else {
                        showBootstrapMessage("#code-message-area", res.message, "danger");
                        if (res.countdown) startCooldown(res.countdown);
                    }
                },
                error: function (xhr) {
                    showBootstrapMessage("#code-message-area", "發送錯誤：" + xhr.responseText, "danger");
                }
            });

        });


        $(document).ready(function () {
            const email = $("#emailInput").val().trim();
            const targetTime = localStorage.getItem(`cooldown_end_${email}`);
            if (targetTime && Date.now() < parseInt(targetTime)) {
                const remaining = Math.floor((parseInt(targetTime) - Date.now()) / 1000);
                startCooldown(remaining);
            }
        });

    </script>


</body>



</html>
