@page
@model Web0524.Pages.Account.MyCouponsModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["MyName"] | 我的優惠券</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            background-color: #fff;
            color: #333;
            font-family: 'Segoe UI', 'Noto Sans TC', sans-serif;
        }

        h2 {
            font-weight: 700;
            color: #222;
        }

        .coupon-wrapper {
            position: relative;
            height: 120px;
            margin-bottom: 1.5rem;
            filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.15));
            -webkit-mask-image: radial-gradient(circle 10px at 0 60px, transparent 10px, black 10px), radial-gradient(circle 10px at 100% 60px, transparent 10px, black 10px);
            -webkit-mask-composite: destination-out;
            mask-composite: exclude;
        }

        .coupon-card {
            height: 100%;
            border-radius: 12px;
            background: white;
            display: flex;
            overflow: hidden;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15); /* 加上陰影 */
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .coupon-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
            }

        .coupon-left {
            width: 100px;
            display: flex;
            flex-direction: column;
            color: #fff;
            font-weight: bold;
            text-align: center;
        }

        .top-half {
            background-color: #ff4d4f;
            flex: 7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .bottom-half {
            background-color: #c62828;
            flex: 3;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            padding: 4px;
        }

        .coupon-right {
            flex: 1;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            font-size: 0.95rem;
            color: #333;
        }


        .coupon-title {
            font-weight: 600;
        }

        .coupon-meta {
            font-size: 0.8rem;
            color: #666;
        }

        .btn-coupon {
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 500;
            color: #fff;
            background-color: #ff4d4f;
            border: none;
            padding: 4px 12px;
            align-self: flex-start;
        }

        .pagination .page-link {
            color: #ff4d4f;
        }

        .pagination .page-item.active .page-link {
            background-color: #ff4d4f;
            border-color: #ff4d4f;
            color: #fff;
        }

    </style>
</head>

<body>
    <div class="container py-5">
        <h2 class="text-center mb-4">🎉 我的優惠券</h2>

        @if (Model.DispatchRecords.Any())
        {
            @foreach (var record in Model.DispatchRecords)
            {
                var c = Model.CouponMap.ContainsKey(record.CouponId) ? Model.CouponMap[record.CouponId] : null;
                if (c == null) { continue; }

                <div class="coupon-card mt-3">
                    <div class="coupon-left @(c.DiscountType == Models.DiscountTypeEnum.FixedAmount ? "fixed" : "percent")">
                        @if (c.DiscountType == Models.DiscountTypeEnum.FixedAmount)
                        {
                            <div class="top-half">
                                <span class="me-1">$</span>@((c.FixedDiscountAmount ?? 0).ToString("0"))
                            </div>
                        }
                        else if (c.DiscountType == Models.DiscountTypeEnum.Percentage)
                        {
                            <div class="top-half">
                                @((c.DiscountAmount).ToString("0"))%off
                            </div>
                        }
                        else
                        {
                            <div class="top-half">🎁</div>
                        }

                        <div class="bottom-half">
                            @(c.MinAmount == 0 ? "不限金額使用" : $"滿 {c.MinAmount.ToString("0")} 元可用")
                        </div>
                    </div>

                    <div class="coupon-right">
                        <div class="cut-line"></div>
                        <div class="coupon-title">
                            <h5 class="fw-bold">@c.Title</h5>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <div class="coupon-meta">@c.ValidFrom.ToShortDateString() ~ @c.ValidTo.ToShortDateString()</div>
                                <button class="btn btn-coupon generate-qr ms-2" data-id="@record.RecordId">去使用</button>
                            </div>
                        </div>
                    </div>
                </div>




            }


        }
        else
        {
            <div class="text-center text-muted mt-5">
                <i class="fas fa-info-circle me-2"></i>目前沒有可使用的優惠券
            </div>
        }


        <div class="d-flex justify-content-between align-items-center mt-4">
            <div class="text-muted">共 <span id="totalCoupons">0</span> 張優惠券</div>
            <nav>
                <ul class="pagination mb-0" id="couponPagination"></ul>
            </nav>
        </div>

    </div>

    <!-- QR Modal -->
    <div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center">
                <div class="modal-header">
                    <h5 class="modal-title">請讓店員掃描此條碼</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="qrcodeArea" class="my-3 d-flex justify-content-center"></div>
                    <small class="text-muted">條碼 1 分鐘內有效，請勿轉傳。</small>
                </div>
            </div>
        </div>
    </div>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>

    <script>
        $(document).ready(function () {
            // 顯示 QRCode
            $('.generate-qr').click(function () {
                var recordId = $(this).data('id');
                $.get('?handler=GenerateQR&recordId=' + recordId, function (data) {
                    $('#qrcodeArea').empty();
                    QRCode.toCanvas(document.createElement("canvas"), data.qr, { width: 256 }, function (err, canvas) {
                        if (!err) {
                            $('#qrcodeArea').append(canvas);
                            var modal = new bootstrap.Modal(document.getElementById('qrModal'));
                            modal.show();
                        }
                    });
                });
            });

            // 分頁功能
            const pageSize = 5;
            const $coupons = $('.coupon-card');
            const totalItems = $coupons.length;
            const totalPages = Math.ceil(totalItems / pageSize);
            let currentPage = 1;

            function renderPagination() {
                const $pagination = $('#couponPagination');
                $pagination.empty();

                const maxButtons = 5;
                let startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
                let endPage = Math.min(totalPages, startPage + maxButtons - 1);
                if (endPage - startPage < maxButtons - 1) {
                    startPage = Math.max(1, endPage - maxButtons + 1);
                }

                // 上一頁
                $pagination.append(`<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                        <a class="page-link" href="#" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a></li>`);

                // 頁碼
                for (let i = startPage; i <= endPage; i++) {
                    $pagination.append(`<li class="page-item ${i === currentPage ? 'active' : ''}">
                            <a class="page-link" href="#">${i}</a></li>`);
                }

                // 下一頁
                $pagination.append(`<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                        <a class="page-link" href="#" aria-label="Next"><span aria-hidden="true">&raquo;</span></a></li>`);
            }

            function showPage(page) {
                currentPage = page;
                $coupons.hide().slice((page - 1) * pageSize, page * pageSize).show();
                renderPagination();
            }

            $('#couponPagination').on('click', 'a.page-link', function (e) {
                e.preventDefault();
                const text = $(this).text();
                if (text === '«' && currentPage > 1) {
                    showPage(currentPage - 1);
                } else if (text === '»' && currentPage < totalPages) {
                    showPage(currentPage + 1);
                } else if (!isNaN(text)) {
                    showPage(parseInt(text));
                }
            });

            $('#totalCoupons').text(totalItems);
            if (totalItems > 0) {
                showPage(1);
            }
        });
    </script>

</body>
</html>
