@page
@model Web0524.Pages.Management.ManageReservationModel
@using Newtonsoft.Json
@using Web0524.Models;

<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://unpkg.com/fullcalendar@6.1.10/main.min.css" rel="stylesheet">
    <script src="https://unpkg.com/fullcalendar@6.1.10/main.min.js"></script>

    <script src="~/js/responsivePaginator.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="container" style="margin-top:200px; margin-bottom:200px;">
        <h2 class="fw-bold">管理預約訂單</h2>

        <h4 class="mt-5">預約行事曆（Google Calendar）</h4>
        <div id="calendar-wrapper" class="mt-4"></div>


        <script>
            function loadResponsiveCalendar() {
                const wrapper = document.getElementById("calendar-wrapper");
                if (!wrapper) return;

                const isMobile = window.matchMedia("(max-width: 768px)").matches;

                const mode = isMobile ? "WEEK" : "MONTH";
                const height = isMobile ? "500px" : "800px";

                const iframe = document.createElement("iframe");
                iframe.src = `https://calendar.google.com/calendar/embed?src=29f882b8d6108305c9a9064e11d25577a699b83939cc49a477bbb32558306a6d%40group.calendar.google.com&mode=${mode}&ctz=Asia%2FTaipei`;
                iframe.style.border = "0";
                iframe.style.width = "100%";
                iframe.style.height = height;
                iframe.setAttribute("frameborder", "0");
                iframe.setAttribute("scrolling", "no");

                wrapper.innerHTML = ""; // 清空原本內容
                wrapper.appendChild(iframe);
            }

            document.addEventListener("DOMContentLoaded", loadResponsiveCalendar);
            window.addEventListener("resize", function () {
                // 重新判斷是否需要切換模式
                loadResponsiveCalendar();
            });
        </script>


        <hr/>


        <h4 class="mt-4">預約訂單列表</h4>
        <!-- 放在表單區域之上，靠近最上層 -->
        <div id="message-wrapper">
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                var isSuccess = Model.Message.Contains("已完成") || Model.Message.Contains("已更新") || Model.Message.Contains("已取消");
                var alertClass = isSuccess ? "alert-success" :
                Model.Message.Contains("失敗") ? "alert-danger" :
                "alert-info";

                <div class="alert @alertClass">@Model.Message</div>
            }
        </div>


        <!-- 日期查詢表單 -->
        @{
            var defaultStartDate = Model.FilterStartDate ?? DateTime.Today;
            var defaultEndDate = Model.FilterEndDate ?? DateTime.Today.AddDays(15);
        }

        <form method="get" class="row g-3 mt-4">
            <div class="col-md-4">
                <input type="date" class="form-control" name="FilterStartDate" placeholder="起始日期" value="@defaultStartDate.ToString("yyyy-MM-dd")">
            </div>

            <div class="col-md-1 text-center">
                <h2>~</h2>
            </div>
            <div class="col-md-4">
                <input type="date" class="form-control" name="FilterEndDate" placeholder="結束日期" value="@defaultEndDate.ToString("yyyy-MM-dd")">
            </div>

            <div class="offset-md-3">
               
            </div>
            <div class="col-md-3">
                <select class="form-select" name="FilterDesignerId">
                    <option value="">全部設計師</option>
                    @foreach (var d in Model.AllDesigners)
                    {
                        <option value="@d.DesignerId" selected="@(Model.FilterDesignerId == d.DesignerId ? "selected" : null)">
                            @d.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" name="FilterProductName" placeholder="服務名稱" value="@Model.FilterProductName">
            </div>
            <div class="col-md-3">
                <select class="form-select" name="FilterStatus">
                    <option value="">全部狀態</option>
                    @foreach (Models.OrderStatus status in Enum.GetValues(typeof(Models.OrderStatus)))
                    {
                        <option value="@status" selected="@(Model.FilterStatus == status ? "selected" : null)">
                            @(status switch
                            {
                                Models.OrderStatus.Pending => "未處理",
                                Models.OrderStatus.Confirmed => "已成立",
                                Models.OrderStatus.Completed => "已完成",
                                Models.OrderStatus.Cancelled => "已取消",
                                _ => status.ToString()
                            })
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-dark w-100">查詢</button>
            </div>
        </form>


        


        <!-- 已預約清單 -->
        <div class="table-responsive mt-4">
            <table class="table table-striped" id="order-table">
                <!-- 表頭與內容將由 JS 動態生成 -->
            </table>
        </div>

        <div class="accordion" id="order-accordion"></div>


        <div id="order-pagination" class="mt-3"></div>



    </div>

    @{
        var orders = Model.AllOrders ?? new List<Order>();
    }

    <script type="application/json" id="order-data-json">
        @Html.Raw(Json.Serialize(orders.Select(o => new
            {
                orderId = o.OrderId,
                reservationDate = o.ReservationDateTime.ToString("yyyy-MM-dd"),
                time = o.ReservationDateTime.ToString("HH:mm"),
                designerName = Model.GetDesignerName(o.DesignerId),
                productName = Model.GetProductName(o.ProductId),
                userName = Model.GetUserName(o.Uid),
                price = o.Price,
                payment = o.PaymentMethod.ToDisplayName(),
                couponTitle = Model.GetCouponTitle(o.UsedCouponId),
                discountAmount = o.DiscountAmount ?? 0,
                finalPrice = o.Price - (double)(o.DiscountAmount ?? 0),
                status = o.Status.ToString(),
                remark = o.Remark,
                orderDate = o.Orderdate.ToString("yyyy-MM-dd HH:mm")
            })))
    </script>

    <script>



        function loadOrdersFromJson() {
            const raw = document.getElementById("order-data-json")?.textContent;
            try {
                return JSON.parse(raw);
            } catch (err) {
                console.error("❌ JSON 解析錯誤", err);
                return [];
            }
        }

        function renderOrderTable(data) {
            window.initResponsivePaginator({
                data,
                tableColumns: [
                    { title: "預約日期", className: 'text-nowrap', render: o => o.reservationDate },
                    { title: "時間", className: 'text-nowrap', render: o => o.time },
                    { title: "設計師", className: 'text-nowrap', render: o => `【${o.designerName || "—"}】` },
                    { title: "預約用戶", className: 'text-nowrap', render: o => o.userName || "—" },
                    { title: "服務項目", className: 'text-nowrap', render: o => `【${o.productName || "—"}】` },
                    {
                        title: "價格", className: 'text-nowrap',
                        render: o => parseFloat(o.price).toLocaleString("zh-TW", { style: "currency", currency: "TWD" })
                    },
                    { title: "付款方式", className: 'text-nowrap', render: o => o.payment },
                    {
                        title: "優惠券", className: 'text-nowrap', render: o => {
                            const showTitle = o.couponTitle !== "—" ? `【${o.couponTitle}】` : "-";
                            const showDiscount = o.discountAmount > 0
                                ? ` (折扣 ${parseInt(o.discountAmount).toLocaleString("zh-TW", { style: "currency", currency: "TWD" })})`
                                : "";
                            return `${showTitle}${showDiscount}`;
                        }
                    },
                    {
                        title: "應付金額", className: 'text-nowrap',
                        render: o => parseFloat(o.finalPrice).toLocaleString("zh-TW", { style: "currency", currency: "TWD" }),
                        className: "text-bold"
                    },
                    {
                        title: "狀態", className: 'text-nowrap', render: o => {
                            switch (o.status) {
                                case "Pending": return `<span class="badge bg-warning text-dark">⏳ 待確認</span>`;
                                case "Confirmed": return `<span class="badge bg-primary">📌 預約中</span>`;
                                case "Completed": return `<span class="badge bg-success">✅ 已完成</span>`;
                                case "Cancelled": return `<span class="badge bg-danger">❌ 已取消</span>`;
                                default: return `<span class="badge bg-secondary">${o.status}</span>`;
                            }
                        }
                    },

                    { title: "備註", render: o => o.remark || "—" },
                    { title: "下單時間", className: 'text-nowrap', render: o => o.orderDate },
                    {
                        title: "操作", className: 'text-nowrap', render: o => {
                            if (o.status === "Confirmed") {
                                return `
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn btn-sm btn-success complete-btn" data-id="${o.orderId}">
                                <i class="fa fa-check"></i> 完成
                            </button>
                            <button class="btn btn-sm btn-danger cancel-btn" data-id="${o.orderId}">
                                <i class="fa fa-times"></i> 取消
                            </button>
                        </div>
                    `;
                            }
                            return `<div class="text-muted text-center">—</div>`;
                        }
                    }




                    
                ],
                tableWrapperId: "order-table",
                accordionWrapperId: "order-accordion",
                paginationWrapperId: "order-pagination",
                pageSize: 10,
                accordionHeaderRender: o => {
                    const [year, month, day] = o.reservationDate.split("-");
                    return `${month}/${day} ${o.time}｜${o.designerName || '未指定'}｜客：${o.userName || '—'}｜${o.productName || '—'}`;
                }


            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            const initialData = loadOrdersFromJson();
            renderOrderTable(initialData);
        });

        document.addEventListener("click", function (e) {
            if (e.target.classList.contains("cancel-btn")) {
                const orderId = e.target.dataset.id;
                if (!confirm(`確定要取消預約單 #${orderId} 嗎？`)) return;

                fetch(window.location.href, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                    },
                    body: new URLSearchParams({
                        "NewOrder.OrderId": orderId,
                        "action": "delete"
                    })
                })
                    .then(response => response.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, "text/html");
                        const newDataRaw = doc.getElementById("order-data-json")?.textContent;
                        const newData = JSON.parse(newDataRaw || "[]");
                        renderOrderTable(newData);

                        const message = doc.querySelector(".alert");

                        const wrapper = document.querySelector("#message-wrapper");

                        if (wrapper) wrapper.innerHTML = ""; // 清空舊訊息
                        if (message) {
                            wrapper.appendChild(message);
                            message.scrollIntoView({ behavior: "smooth" });
                        }



                    })
                    .catch(err => {
                        alert("❌ 取消失敗，請稍後再試");
                        console.error(err);
                    });
            }
            if (e.target.classList.contains("complete-btn")) {
                const orderId = e.target.dataset.id;
                if (!confirm(`確認將預約單 #${orderId} 設為已完成？`)) return;

                fetch(window.location.href, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                    },
                    body: new URLSearchParams({
                        "NewOrder.OrderId": orderId,
                        "NewOrder.Status": "Completed",
                        "action": "update"
                    })
                })
                    .then(response => response.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, "text/html");
                        const newDataRaw = doc.getElementById("order-data-json")?.textContent;
                        const newData = JSON.parse(newDataRaw || "[]");
                        renderOrderTable(newData);

                        const message = doc.querySelector(".alert");

                        const wrapper = document.querySelector("#message-wrapper");

                        if (wrapper) wrapper.innerHTML = ""; // 清空舊訊息
                        if (message) {
                            wrapper.appendChild(message);
                            message.scrollIntoView({ behavior: "smooth" });
                        }




                    })
                    .catch(err => {
                        alert("❌ 更新失敗，請稍後再試");
                        console.error(err);
                    });
            }

        });
        document.addEventListener("DOMContentLoaded", function () {
            const initialData = loadOrdersFromJson();
            renderOrderTable(initialData);
        });

    </script>


</body>
</html>
