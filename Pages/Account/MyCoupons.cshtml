@page
@model Web0524.Pages.Account.MyCouponsModel
@{
}
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["MyName"] | 會員登入</title>

    <!-- ChatGPT Style -->
    <link rel="stylesheet" href="/assets/root-DertGWcZ.css">
    <link rel="stylesheet" href="/assets/AuthStepLayout-D1Ycd_TU.css">
    <link rel="stylesheet" href="/assets/branding-D5M_DFHW.css">
    <link rel="stylesheet" href="/assets/Button-DEcOZt8f.css">
    <link rel="stylesheet" href="/assets/TextInput-DliBbVLE.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script type="text/javascript" src="https://auth.openai.com/sentinel/sdk.js" async defer></script>
</head>

<body>
    <div class="container">
        <h2 class="mt-4">我的可用優惠券</h2>

        @if (Model.DispatchRecords.Any())
        {
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>標題</th>
                        <th>內容</th>
                        <th>有效期間</th>
                        <th>最低金額</th>
                        <th>折扣</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.DispatchRecords)
                    {
                        var c = Model.CouponMap.ContainsKey(record.CouponId) ? Model.CouponMap[record.CouponId] : null;
                        if (c == null) { continue; }

                        <tr>
                            <td>@c.Title</td>
                            <td>@c.Remark</td>
                            <td>@c.ValidFrom:yyyy-MM-dd ~ @c.ValidTo:yyyy-MM-dd</td>
                            <td>@c.MinAmount.ToString("C0")</td>
                            <td>
                                @if (c.DiscountType == Models.DiscountTypeEnum.FixedAmount)
                                {
                                    <span>@c.FixedDiscountAmount?.ToString("C0")</span>
                                }
                                else
                                {
                                    <span>@c.DiscountAmount.ToString("0.#")%</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary generate-qr" data-id="@record.RecordId">使用</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">目前沒有可使用的優惠券</div>
        }
    </div>

    <!-- 條碼顯示 Modal -->
    <div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center">
                <div class="modal-header">
                    <h5 class="modal-title">請讓店員掃描此條碼</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="qrcodeArea" class="my-3"></div>
                    <small class="text-muted">條碼 1 分鐘內有效，請勿轉傳。</small>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.generate-qr').click(function () {
                var recordId = $(this).data('id');
                $.get('?handler=GenerateQR&recordId=' + recordId, function (data) {
                    $('#qrcodeArea').empty();
                    QRCode.toCanvas(document.createElement("canvas"), data.qr, { width: 256 }, function (err, canvas) {
                        if (!err) {
                            $('#qrcodeArea').append(canvas);
                            var modal = new bootstrap.Modal(document.getElementById('qrModal'));
                            modal.show();
                        }
                    });
                });
            });
        });
    </script>



</body>




</html>
