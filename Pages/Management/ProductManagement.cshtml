@page
@model Web0524.Pages.Management.ProductManagementModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <script src="~/js/responsivePaginator.js"></script>



    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet" media="all">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


</head>

<body>

    @Html.AntiForgeryToken()
    <div class="container" style="margin-top:200px; margin-bottom:200px;">

        <div id="message-area"></div>
        <h2 class="mb-4 fw-bold">產品管理</h2>

        

        <form id="productForm" enctype="multipart/form-data">
            <input type="hidden" asp-for="Product.ProductId" />

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">產品群組</label>
                        <select asp-for="Product.PGid" class="form-control">
                            @foreach (var pg in Model.PGroups)
                            {
                                <option value="@pg.PGid">@pg.PGname</option>
                            }
                        </select>
                        <a href="/Management/PGManagement" class="btn btn-link p-0 mt-1">前往群組管理</a>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">價格</label>
                        <input asp-for="Product.Price" class="form-control" type="number" step="0.01" />
                    </div>


                    <div class="mb-3">
                        <label class="form-label">產品說明</label>
                        <textarea asp-for="Product.Content" class="form-control"></textarea>
                    </div>




                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">產品名稱</label>
                        <input asp-for="Product.Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">產品狀態</label>
                        <select asp-for="Product.ProductState" class="form-control">
                            <option value="1">啟用</option>
                            <option value="0">停用</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">上傳圖片</label>
                        <input type="file" name="PhotoFile" class="form-control" id="photoFileInput" />
                        <img id="previewImage"
                             src="@(Model.Product.ProductId > 0 ? Url.Page("ProductManagement", "Image", new { id = Model.Product.ProductId }) : "#")"
                             alt="圖片預覽"
                             style="@(Model.Product.ProductId > 0 ? "display:block;" : "display:none;") max-height:200px; margin-top:10px;" />

                    </div>
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn btn-dark">儲存</button>
                </div>
            </div>
        </form>

        <hr />

        <h4>產品清單</h4>
        <div class="row mb-3 g-3">
            <div class="col-md-3">
                <select id="filterGroup" class="form-select">
                    <option value="">全部群組</option>
                    @foreach (var pg in Model.PGroups)
                    {
                        <option value="@pg.PGid">@pg.PGname</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select id="filterState" class="form-select">
                    <option value="">全部狀態</option>
                    <option value="1">啟用</option>
                    <option value="0">停用</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover mt-3" id="productTableBody">


            </table>
        </div>


        <div class="product-accordion">
            <div class="accordion" id="productAccordion"></div>

        </div>

        <div id="pagination" class="mt-3 text-center"></div>


    </div>

    <script>
        $("#productForm").submit(function (e) {
            e.preventDefault();
            let formData = new FormData(this);
            $.ajax({
                url: '?handler=Save',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    resetForm();
                    $("#message-area").html(`<div class="alert alert-success">${res.message}</div>`);
                    
                },
                error: function () {
                    $("#message-area").html(`<div class="alert alert-danger">儲存失敗，請再試一次。</div>`);
                }
            });
        });
        function resetForm() {
            // 清除所有 input/select/textarea 的值
            $("#productForm")[0].reset();

            // 確保 ASP.NET Core 綁定欄位的名稱都能重設乾淨
            $("input[name='Product.ProductId']").val("");
            $("input[name='Product.Price']").val("");
            $("input[name='Product.Name']").val("");
            $("textarea[name='Product.Content']").val("");
            $("select[name='Product.PGid']").val(""); // 群組
            $("select[name='Product.ProductState']").val(""); // 狀態

            // 清除圖片預覽
            $("#previewImage").attr("src", "#").hide();

            // 清除檔案選擇
            $("#photoFileInput").val("");

            // 重新渲染表格（可選）
            applyFilters();
        }

        $(".delete-btn").click(function () {
            if (!confirm("確認刪除？")) return;
            const id = $(this).data("id");
            $.ajax({
                url: `?handler=Delete&id=${id}`,
                method: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    $("#message-area").html(`<div class="alert alert-warning">${res.message}</div>`);
                    setTimeout(() => location.reload(), 1000);
                },
                error: function () {
                    $("#message-area").html(`<div class="alert alert-danger">刪除失敗</div>`);
                }
            });
        });
    </script>
    <script>
        document.getElementById("photoFileInput").addEventListener("change", function (event) {
            const file = event.target.files[0];
            if (file && file.type.startsWith("image/")) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById("previewImage");
                    img.src = e.target.result;
                    img.style.display = "block";
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
    <script>
        const allProducts = @Html.Raw(Json.Serialize(Model.Products));
        const pgroupMap = @Html.Raw(Json.Serialize(Model.PGroups.ToDictionary(pg => pg.PGid, pg => pg.PGname)));

        let filteredProducts = allProducts;

        function applyFilters() {
            const groupFilter = $("#filterGroup").val();
            const stateFilter = $("#filterState").val();

            filteredProducts = allProducts.filter(p => {
                const matchGroup = groupFilter === "" || p.pGid.toString() === groupFilter;
                const matchState = stateFilter === "" || p.productState.toString() === stateFilter;
                return matchGroup && matchState;
            });

            renderTable(); // 重新渲染分頁
        }

        function renderTable() {
            initResponsivePaginator({
                data: filteredProducts,
                pageSize: 10,
                tableWrapperId: "productTableBody",
                accordionWrapperId: "productAccordion",
                paginationWrapperId: "pagination",
                tableColumns: [
                    { title: "產品編號", className: 'text-nowrap', render: p => p.productId },
                    { title: "名稱", className: 'text-nowrap', render: p => p.name },
                    { title: "價格", className: 'text-nowrap', render: p => `$${p.price}` },
                    { title: "群組", className: 'text-nowrap', render: p => pgroupMap[p.pGid] || "未知" },
                    {
                        title: "狀態",
                        className: 'text-nowrap',
                        render: p => p.productState === 1
                            ? `<span class="badge bg-success">啟用</span>`
                            : `<span class="badge bg-secondary">停用</span>`
                    }
                ],
                renderRowButtons: p => `
                        <a href="?id=${p.productId}" class="btn btn-sm btn-secondary">編輯</a>
                        <button class="btn btn-sm btn-danger delete-btn" data-id="${p.productId}">刪除</button>
                    `,
                accordionHeaderRender: p => `${p.name} - $${p.price}`
            });
        }

        // 初始渲染
        renderTable();

        // 綁定篩選器變更事件
        $("#filterGroup, #filterState").on("change", applyFilters);
    </script>



</body>


</html>
