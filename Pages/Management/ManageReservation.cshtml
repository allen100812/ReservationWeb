@page
@model Web0524.Pages.Management.ManageReservationModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>

    <div class="container" style="margin-top:200px;">
        <h2>管理預約訂單</h2>

        <!-- 日期查詢表單 -->
        <form method="get" class="mb-4">
            <div class="row g-2 align-items-center">
                <div class="col-auto">
                    <label for="date" class="form-label">選擇日期</label>
                    <input type="date" id="date" name="selectedDate" class="form-control"
                           value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-primary mt-4">查詢可預約項目</button>
                </div>
            </div>
        </form>

        <!-- 可預約服務清單 -->
        @if (Model.AvailableSlotDetails?.Any() == true)
        {
            <h4>可預約項目</h4>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>時間</th>
                        <th>設計師</th>
                        <th>服務ID</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in Model.AvailableSlotDetails)
                    {
                        var designer = Model.AllDesigners.FirstOrDefault(d => d.DesignerId == slot.DesignerId);
                        var modalId = $"modal_{slot.DesignerId}_{slot.ProductId}_{slot.StartTime:HHmm}";
                        <tr>
                            <td>@slot.StartTime.ToString("HH:mm")</td>
                            <td>@designer?.Name</td>
                            <td>@slot.ProductId</td>
                            <td>
                                <!-- 預約按鈕 -->
                                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#@modalId">預約</button>

                                <!-- Modal -->
                                <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="label_@modalId" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="label_@modalId">填寫預約資訊</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <input type="hidden" name="NewOrder.DesignerId" value="@slot.DesignerId" />
                                                    <input type="hidden" name="NewOrder.ProductId" value="@slot.ProductId" />
                                                    <input type="hidden" name="NewOrder.ReservationDateTime" value="@slot.StartTime.ToString("yyyy-MM-ddTHH:mm")" />

                                                    <div class="mb-3">
                                                        <label>付款方式</label>
                                                        <select name="NewOrder.PaymentMethod" class="form-select" required>
                                                            <option value="">選擇付款方式</option>
                                                            <option value="0">現金</option>
                                                            <option value="1">刷卡</option>
                                                            <option value="2">Line Pay</option>
                                                        </select>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label>選擇使用者</label>
                                                        <select name="NewOrder.Uid" class="form-select" required>
                                                            <option value="">選擇用戶</option>
                                                            @foreach (var u in Model.AllUsers)
                                                            {
                                                                <option value="@u.Id">@u.Name (@u.Id)</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label>備註</label>
                                                        <input type="text" name="NewOrder.Remark" class="form-control" placeholder="可留空" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="submit" name="action" value="add" class="btn btn-success">送出預約</button>
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- 已預約清單 -->
        <h4 class="mt-5">當日已預約訂單</h4>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>訂單ID</th>
                    <th>設計師</th>
                    <th>服務</th>
                    <th>預約時間</th>
                    <th>付款方式</th>
                    <th>備註</th>
                    <th>用戶</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.AllOrders)
                {
                    var d = Model.AllDesigners.FirstOrDefault(x => x.DesignerId == o.DesignerId);
                    <tr>
                        <td>@o.OrderId</td>
                        <td>@d?.Name</td>
                        <td>@o.ProductId</td>
                        <td>@o.ReservationDateTime.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>@((o.PaymentMethod == 0 ? "現金" : o.PaymentMethod == 1 ? "刷卡" : "Line Pay"))</td>
                        <td>@o.Remark</td>
                        <td>@o.Uid</td>
                        <td>
                            <form method="post">
                                <input type="hidden" name="NewOrder.OrderId" value="@o.OrderId" />
                                <button type="submit" name="action" value="delete" class="btn btn-danger btn-sm">取消</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- 顯示訊息 -->
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info">@Model.Message</div>
        }
    </div>
</body>
</html>
