        .modal-text {
            color: var(--color3);
        }

        .modal-title {
            color: var(--color3);
        }

        body {
            margin: 0;
            font-family: sans-serif;
            background: #f0f0f0;
        }

        button {
            margin: 2rem;
            padding: 1rem 2rem;
            font-size: 1.2rem;
        }

        /* === 選單外層 === */
        .fullscreen-menu {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.85);
            z-index: 9999;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s ease;
            display: flex;
            justify-content: center;
            align-items: flex-start; /* 改為頂部對齊 */
            overflow-y: auto; /* ✅ 可上下滾動 */
            max-height: 100vh; /* ✅ 限制最大高度 */
            padding-top: 80px; /* ✅ 預留關閉按鈕與上方空間 */
        }

            .fullscreen-menu.active {
                opacity: 1;
                pointer-events: auto;
            }


        /* === 背景面板動畫 === */
        .menu-panel {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transform: translateY(100%) rotateX(20deg) rotateY(-10deg);
            opacity: 0;
            transition: transform 0.8s ease, opacity 0.6s ease;
            transform-origin: bottom center;
        }

        .fullscreen-menu.show .menu-panel {
            transform: translateY(0) rotateX(0) rotateY(0);
            opacity: 1;
        }

        .fullscreen-menu.hide .menu-panel {
            transform: translateY(-100%) rotateX(-20deg) rotateY(10deg);
            opacity: 0;
        }

        .close-btn {
            position: absolute;
            top: 1.5rem;
            right: 2rem;
            font-size: 2rem;
            color: white;
            background: none;
            border: none;
            cursor: pointer;
            z-index: 10000;
        }

        /* === 文字內容動畫 === */
        .menu-content {
            width: 100%;
            max-width: 480px;
            padding: 1rem;
            text-align: center;
            color: white;
            opacity: 0;
            transform: translateY(0);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

            .menu-content.fade-in {
                opacity: 1;
            }

            .menu-content.move-up {
                transform: translateY(-10px);
            }

            .menu-content.move-down {
                transform: translateY(10px);
            }

        .logo {
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 1rem;
        }

        .menu-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .menu-item,
            .menu-list li a {
                color: white;
                font-size: 1.5rem;
                margin: 0.5rem 0;
                display: inline-block;
                text-decoration: none;
                transition: transform 0.3s ease;
            }

                .menu-item:hover,
                .menu-list li a:hover {
                    transform: translateY(-3px);
                }
        /* 下拉選單容器 */
        .dropdown-menu {
            background-color: rgba(0, 0, 0, 0.7) !important; /* 半透明黑底 */
            color: #ffffff !important; /* 白色文字 */
            border: none;
            backdrop-filter: blur(8px); /* 背景模糊效果 */
            transform-origin: top center;
            transform: perspective(800px) rotateX(0deg);
            transition: transform 0.3s ease;
        }

            /* 下拉選單展開動畫（選擇性使用） */
            .dropdown-menu.show {
                transform: perspective(800px) rotateX(0deg) translateY(0);
            }

            /* 每個選單項目 */
            .dropdown-menu .dropdown-item {
                color: #ffffff !important; /* 確保文字為白色 */
                font-weight: 500;
                padding: 0.5rem 1.2rem;
                transition: background-color 0.3s ease, transform 0.2s ease;
                background-color: transparent !important;
            }

                /* Hover 時：滑動 + 微亮背景，不變色 */
                .dropdown-menu .dropdown-item:hover,
                .dropdown-menu .dropdown-item:focus {
                    transform: translateY(-3px); /* 微上移動畫 */
                    background-color: rgba(255, 255, 255, 0.1) !important; /* 微亮背景 */
                    color: #ffffff !important; /* 仍為白色字 */
                }

            .dropdown-menu .dropdown-item {
                text-shadow: 0 0 2px rgba(0, 0, 0, 0.5); /* 黑色微陰影提亮白字 */
            }


        /* 隱藏 dropdown-toggle 預設箭頭 */
        .dropdown-toggle::after {
            display: none !important;
        }

        /* 移除藍色底線或 outline */
        .dropdown-toggle:focus,
        .dropdown-toggle:active,
        .dropdown-toggle:visited {
            outline: none !important;
            box-shadow: none !important;
            text-decoration: none !important;
            color: inherit;
        }

        @@media (max-width: 576px) {
    /* 修正右上角使用者下拉選單在手機上超出邊界問題 */
    .navbar .dropdown-menu {
        left: auto !important;
        right: 0 !important;
        min-width: 180px; /* ✅ 設定最小寬度 */
        max-width: 90vw;  /* ✅ 避免超出右邊界 */
        word-break: break-word;
    }

    /* 使用者頭像靠右排列時不要讓選單被遮擋 */
    .navbar .dropdown-menu::before,
    .navbar .dropdown-menu::after {
        display: none; /* 移除 dropdown 箭頭（可選） */
    }
}


