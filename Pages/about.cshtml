@page
@model Web0524.Pages.aboutModel
@inject Web0524.Models.My MySetting
@{
    var content = MySetting.AboutPage;
}


<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>關於我們 - SuperiorSeed</title>

    <!-- 字體與動畫 -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Quicksand:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet"/>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/2.0.2/anime.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

    <!-- 共用樣式 -->
    <link rel="stylesheet" href="~/css/Share.css">

    <style>
        body {
            font-family: 'Quicksand', 'Microsoft JhengHei', sans-serif;
            background: #f8f9fa;
        }

        header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.8rem;
            font-weight: bold;
            color: var(--color3);
            text-align: center;
            margin-bottom: 3rem;
        }

        .fixed-height-col {
            height: 350px;
            overflow: hidden;
            position: relative;
        }

        .img_show {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: transform 0.5s ease;
        }

        .img_show:hover {
            transform: scale(1.05);
        }

        .text-show {
            display: flex;
            justify-content: center;
            align-items: center;
            background: rgba(255, 255, 255, 0.9);
            padding: 2rem;
            border-radius: 12px;
            height: 100%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .text-show h2 {
            font-weight: 600;
            color: #222;
            margin-bottom: 1rem;
        }

        .text-show p, .text-show li {
            color: #555;
            font-size: 1rem;
            line-height: 1.7;
        }

        .text-show ul {
            padding-left: 1.2rem;
        }

        .ml2 .letter {
            display: inline-block;
            line-height: 1em;
        }

        @@media screen and (max-width: 768px) {
            .fixed-height-col {
                height: auto;
            }
            .text-show {
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="container" style="margin-top:200px ;margin-bottom:200px;">
        <header>
            <h1 class="ml2">@content.HeroTitle</h1>
        </header>

        <!-- 第一區塊 -->
        <div class="row mb-4 align-items-center">
            <div class="col-md-6 fixed-height-col">
                <section class="text-show animate__animated animate__fadeInLeft">
                    <div>
                        <h2>@content.Section1_Title</h2>
                        <p>@content.Section1_Paragraph1</p>
                        <p>@content.Section1_Paragraph2</p>
                    </div>
                </section>
            </div>
            <div class="col-md-6 fixed-height-col">
                <img class="img_show" src="~/dist/img/about1.jpg" alt="關於我們">
            </div>
        </div>

        <!-- 第二區塊 -->
        <div class="row mb-4 align-items-center">
            <div class="col-md-6 fixed-height-col order-md-2">
                <section class="text-show animate__animated animate__fadeInRight">
                    <div>
                        <h2>@content.Section2_Title</h2>
                        <p>@content.Section2_Paragraph1</p>
                        <p>@content.Section2_Paragraph2</p>
                    </div>
                </section>
            </div>
            <div class="col-md-6 fixed-height-col order-md-1">
                <img class="img_show" src="~/dist/img/about2.jpg" alt="使命">
            </div>
        </div>

        <!-- 第三區塊 -->
        <div class="row mb-4 align-items-center">
            <div class="col-md-6 fixed-height-col">
                <section class="text-show animate__animated animate__fadeInLeft">
                    <div>
                        <h2>@content.Section3_Title</h2>
                        <ul>
                            @foreach (var item in content.Section3_Items)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </div>
                </section>
            </div>
            <div class="col-md-6 fixed-height-col">
                <img class="img_show" src="~/dist/img/about3.jpg" alt="服務">
            </div>
        </div>
    </div>
    <script>
        var textWrapper = document.querySelector('.ml2');
        textWrapper.innerHTML = textWrapper.textContent.replace(/\S/g, "<span class='letter'>$&</span>");

        anime.timeline({ loop: false })
            .add({
                targets: '.ml2 .letter',
                scale: [4, 1],
                opacity: [0, 1],
                translateZ: 0,
                easing: "easeOutExpo",
                duration: 950,
                delay: (el, i) => 70 * i
            });
    </script>
</body>
</html>
