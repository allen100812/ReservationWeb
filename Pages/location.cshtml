@page
@model Web0524.Pages.locationModel
@{
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet" media="all">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: "Microsoft JhengHei", sans-serif;
        }

        .hero-image {
            background-image: url('your-location-header.jpg'); /* 替換為你的圖片 */
            background-size: cover;
            background-position: center;
            height: 400px;
            position: relative;
        }

        .hero-text {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 2rem;
            letter-spacing: 2px;
        }

        .section-btn {
            background-color: #666;
            color: white;
            padding: 0.8rem 2rem;
            font-size: 1.2rem;
            margin: 2rem auto;
            display: block;
            border: none;
        }

        .branch {
            padding: 2rem 0;
        }

        .branch h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .branch p {
            margin-bottom: 0.5rem;
            color: #555;
        }

        .map-wrapper {
            width: 100%;
            height: 350px;
            border: 1px solid #ccc;
            border-radius: 8px;
            overflow: hidden;
        }

        .location-block {
            margin-bottom: 3rem;
        }
    </style>
</head>
<body>

    <div class="hero-image">
        <div class="hero-text">Our Locations</div>
    </div>

    <button class="section-btn">商家據點</button>

    <div class="container branch">
        <!-- 第一個據點 -->
        <div class="location-block">
            <h3>總店 - 竹北店</h3>
            <p><i class="fas fa-map-marker-alt"></i> 新竹縣竹北市自強五路37號</p>
            <p><i class="fas fa-phone"></i> 03-6681222</p>
            <div class="map-wrapper">
                <iframe src="https://www.google.com/maps?q=新竹縣竹北市自強五路37號&output=embed" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>

        <!-- 第二個據點（選填） -->
        <div class="location-block">
            <h3>分店 - 台北店</h3>
            <p><i class="fas fa-map-marker-alt"></i> 台北市信義區松高路</p>
            <p><i class="fas fa-phone"></i> 02-12345678</p>
            <div class="map-wrapper">
                <iframe src="https://www.google.com/maps?q=台北市信義區松高路&output=embed" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>

        <!-- 第三個據點（選填） -->
        <div class="location-block">
            <h3>分店 - 台中店</h3>
            <p><i class="fas fa-map-marker-alt"></i> 台中市西區公益路</p>
            <p><i class="fas fa-phone"></i> 04-87654321</p>
            <div class="map-wrapper">
                <iframe src="https://www.google.com/maps?q=台中市西區公益路&output=embed" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>
    </div>

</body>
</html>
