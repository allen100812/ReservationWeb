@page
@model Web0524.Pages.locationModel
@{
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet" media="all">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- 字型與動畫 -->
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.1.2/wow.min.js"></script>
    <script>new WOW().init();</script>

    <style>
        body {
            font-family: 'Quicksand', 'Microsoft JhengHei', sans-serif;
            background: #f5f7fa;
        }


            .section-btn:hover {
                transform: scale(1.05);
            }

        .section-btn {
            background-color: #666;
            color: white;
            padding: 0.8rem 2rem;
            font-size: 1.2rem;
            margin: 2rem auto;
            display: block;
            border: none;
        }
        .location-block {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 3rem;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

            .location-block:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
            }

            .location-block h3 {
                font-weight: 700;
                color: #333;
                margin-bottom: 1rem;
            }

            .location-block p {
                font-size: 1.1rem;
                color: #444;
                margin-bottom: 0.5rem;
            }

        .map-wrapper {
            width: 100%;
            height: 300px;
            border-radius: 12px;
            overflow: hidden;
            margin-top: 1rem;
            transition: transform 0.3s ease;
        }

            .map-wrapper iframe {
                width: 100%;
                height: 100%;
                border: none;
                transition: transform 0.3s ease;
            }

            .map-wrapper:hover iframe {
                transform: scale(1.02);
            }
    </style>


    <style>
        .hero-image {
            position: relative;
            height: 30vh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #000; /* 防止圖片未載入前閃白 */
        }

            .hero-image img {
                position: absolute;
                top: 50%;
                transform: translate(-50%, -50%);
                min-width: 100%;
                min-height: 100%;
                object-fit: cover;
                z-index: 1;
            }

            .hero-image::after {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(255, 255, 255, 0.25);
                backdrop-filter: blur(4px);
                -webkit-backdrop-filter: blur(4px);
                z-index: 2;
            }

        .hero-text {
            position: relative;
            z-index: 3;
            color: white;
            font-size: 2.5rem;
            font-weight: bold;
            text-shadow: 0 0 5px rgba(0, 0, 0, 0.5);
        }



        body {
            font-family: "Microsoft JhengHei", sans-serif;
        }


        .hero-text {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 2rem;
            letter-spacing: 2px;
        }



        .branch {
            padding: 2rem 0;
        }

            .branch h3 {
                font-size: 1.5rem;
                margin-bottom: 1rem;
            }

            .branch p {
                margin-bottom: 0.5rem;
                color: #555;
            }

        .map-wrapper {
            width: 100%;
            height: 350px;
            border: 1px solid #ccc;
            border-radius: 8px;
            overflow: hidden;
        }

        .location-block {
            margin-bottom: 3rem;
        }
    </style>
</head>
<body>

    <div class="hero-image">
        <div class="hero-text">Our Locations</div>
        <img src="/dist/img/banner_locations.jpg" class="d-block w-100" alt="...">
    </div>



    <div class="container" style="margin-bottom:200px;">
        <button class="section-btn">商家據點</button>

        <div class="location-block wow animate__animated animate__fadeInUp" data-wow-delay="0.1s">
            <h3>總店 - 竹北店</h3>
            <p><i class="fas fa-map-marker-alt"></i> 新竹縣竹北市自強五路37號</p>
            <p><i class="fas fa-phone"></i> 03-6681222</p>
            <div class="map-wrapper">
                <iframe src="https://www.google.com/maps?q=新竹縣竹北市自強五路37號&output=embed" loading="lazy"></iframe>
            </div>
        </div>

        <div class="location-block wow animate__animated animate__fadeInUp" data-wow-delay="0.3s">
            <h3>分店 - 台北店</h3>
            <p><i class="fas fa-map-marker-alt"></i> 台北市信義區松高路</p>
            <p><i class="fas fa-phone"></i> 02-12345678</p>
            <div class="map-wrapper">
                <iframe src="https://www.google.com/maps?q=台北市信義區松高路&output=embed" loading="lazy"></iframe>
            </div>
        </div>

        <div class="location-block wow animate__animated animate__fadeInUp" data-wow-delay="0.5s">
            <h3>分店 - 台中店</h3>
            <p><i class="fas fa-map-marker-alt"></i> 台中市西區公益路</p>
            <p><i class="fas fa-phone"></i> 04-87654321</p>
            <div class="map-wrapper">
                <iframe src="https://www.google.com/maps?q=台中市西區公益路&output=embed" loading="lazy"></iframe>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('scroll', () => {
            const img = document.querySelector('.hero-image img');
            const scrollY = window.scrollY;
            img.style.transform = `translateY(calc(-50% + ${scrollY * 0.2}px))`;
        });
    </script>
    <script>
        function updateHeroImagePosition() {
            const img = document.querySelector('.hero-image img');
            const scrollY = window.scrollY;
            img.style.transform = `translateY(calc(-50% + ${scrollY * 0.2}px))`;
        }

        // 初始載入就執行一次
        window.addEventListener('load', updateHeroImagePosition);
        // 滾動時也更新位置
        document.addEventListener('scroll', updateHeroImagePosition);
    </script>



</body>
</html>
