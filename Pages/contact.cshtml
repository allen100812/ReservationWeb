@page
@model Web0524.Pages.contactModel
@{
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>聯絡我們 - HOZO 賀澤設計</title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet" media="all">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- 字型與動畫 -->
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.1.2/wow.min.js"></script>
    <script>new WOW().init();</script>


    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <!-- Custom Font -->
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Quicksand', 'Microsoft JhengHei', sans-serif;
            background: linear-gradient(to right, #f8fafc, #e3e7ec);
            color: #333;
        }


        .section-btn:hover {
            transform: scale(1.05);
        }

        .section-btn {
            background-color: #666;
            color: white;
            padding: 0.8rem 2rem;
            font-size: 1.2rem;
            margin: 2rem auto;
            display: block;
            border: none;
        }

        .contact-blocks {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .contact-block {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
            text-align: center;
            transition: all 0.3s ease;
        }

            .contact-block:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
            }

            .contact-block i {
                font-size: 2rem;
                color: #2c3e50;
                margin-bottom: 1rem;
            }

            .contact-block b {
                display: block;
                font-size: 1.1rem;
                margin-bottom: 0.5rem;
            }


        .hero-image {
            position: relative;
            height: 30vh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #000; /* 防止圖片未載入前閃白 */
        }

            .hero-image img {
                position: absolute;
                top: 50%;
                transform: translate(-50%, -50%);
                min-width: 100%;
                min-height: 100%;
                object-fit: cover;
                z-index: 1;
            }

            .hero-image::after {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(255, 255, 255, 0.25);
                backdrop-filter: blur(4px);
                -webkit-backdrop-filter: blur(4px);
                z-index: 2;
            }

        .hero-text {
            position: relative;
            z-index: 3;
            color: white;
            font-size: 2.5rem;
            font-weight: bold;
            text-shadow: 0 0 5px rgba(0, 0, 0, 0.5);
        }



        body {
            font-family: "Microsoft JhengHei", sans-serif;
        }


        .hero-text {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 2rem;
            letter-spacing: 2px;
        }

    </style>
</head>
<body>


    <div class="hero-image">
        <div class="hero-text">Contact</div>
        <img src="/dist/img/banner_locations.jpg" class="d-block w-100" alt="...">
    </div>
    <div class="container" style="margin-bottom:200px;">

        <button class="section-btn">商家據點</button>

        <div class="text-center">
            <h2 class="my-4 wow fadeInUp">有問題想聯絡賀澤設計嗎？</h2>
            <p class="wow fadeInUp" data-wow-delay="0.1s">
                專注傾聽客戶的意見，如果您有任何需要服務的地方，都歡迎隨時跟我們連繫。<br>
                您可以直接撥打電話，或利用下方的聯絡資訊，我們的服務人員會盡快回覆給您，感謝您的指教與愛護！
            </p>
        </div>

        <div class="contact-blocks mt-5">
            <div class="contact-block wow fadeInUp" data-wow-delay="0.1s">
                <i class="fas fa-phone"></i>
                <b>TEL</b>
                <div>886-3-6681222</div>
            </div>
            <div class="contact-block wow fadeInUp" data-wow-delay="0.2s">
                <i class="fas fa-envelope"></i>
                <b>E-MAIL</b>
                <div>hozo.design@gmail.com</div>
            </div>
            <div class="contact-block wow fadeInUp" data-wow-delay="0.3s">
                <i class="fas fa-map-marker-alt"></i>
                <b>聯絡地址</b>
                <div>新竹縣竹北市自強五路37號</div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('scroll', () => {
            const img = document.querySelector('.hero-image img');
            const scrollY = window.scrollY;
            img.style.transform = `translateY(calc(-50% + ${scrollY * 0.2}px))`;
        });
    </script>
    <script>
        function updateHeroImagePosition() {
            const img = document.querySelector('.hero-image img');
            const scrollY = window.scrollY;
            img.style.transform = `translateY(calc(-50% + ${scrollY * 0.2}px))`;
        }

        // 初始載入就執行一次
        window.addEventListener('load', updateHeroImagePosition);
        // 滾動時也更新位置
        document.addEventListener('scroll', updateHeroImagePosition);
    </script>

</body>
</html>
