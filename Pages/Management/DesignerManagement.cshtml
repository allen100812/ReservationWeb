@page
@model Web0524.Pages.Management.DesignerManagementModel
@{
}


<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <div class="container" style="margin-top:200px;">

        <h2>設計師管理</h2>

        <form method="post">
            <div class="row g-2">
                <div class="col-md-4">
                    <input asp-for="NewDesigner.Name" class="form-control" placeholder="設計師姓名" required />
                </div>
                <div class="col-md-4">
                    <input asp-for="NewDesigner.Nickname" class="form-control" placeholder="暱稱" />
                </div>
                <div class="col-md-4">
                    <button type="submit" name="action" value="add" class="btn btn-success">新增設計師</button>
                </div>
            </div>
        </form>

        @if (Model.AllDesigners.Any())
        {
            <table class="table table-bordered table-hover mt-4">
                <thead>
                    <tr>
                        <th>編號</th>
                        <th>姓名</th>
                        <th>暱稱</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.AllDesigners)
                    {
                        <tr>
                            <td>@d.DesignerId</td>
                            <td>@d.Name</td>
                            <td>@d.Nickname</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="DesignerId" value="@d.DesignerId" />
                                    <button type="submit" name="action" value="delete" class="btn btn-sm btn-danger">刪除</button>
                                </form>
                            </td>
                        </tr>
                        <tr class="bg-light">
                            <td colspan="4">
                                <strong>排程規則</strong>
                                @if (d.ScheduleRules.Any())
                                {
                                    <table class="table table-bordered table-sm mt-2">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th>產品 ID</th>
                                                <th>耗時（分鐘）</th>
                                                <th>最大人數</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var rule in d.ScheduleRules)
                                            {
                                                <tr>
                                                    <td>@rule.ProductId</td>
                                                    <td>@rule.DurationMinutes</td>
                                                    <td>@rule.MaxCustomers</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <p class="text-muted">尚未設定規則</p>
                                }

                                <form method="post" class="row g-2 mt-2 align-items-end">
                                    <input type="hidden" name="DesignerId" value="@d.DesignerId" />
                                    <div class="col-md-2">
                                        <select name="NewRule.ProductId" class="form-select" required>
                                            <option value="">請選擇產品</option>
                                            @foreach (var p in Model.AllProducts)
                                            {
                                                <option value="@p.ProductId">@p.Name</option>
                                            }
                                        </select>

                                    </div>
                                    <div class="col-md-2">
                                        <input type="number" name="NewRule.DurationMinutes" class="form-control" placeholder="耗時（分鐘）" required />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="number" name="NewRule.MaxCustomers" class="form-control" placeholder="最大人數" required />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" name="action" value="addrule" class="btn btn-primary btn-sm">新增排程規則</button>
                                    </div>
                                </form>
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        }

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info mt-3">@Model.Message</div>
        }

    </div>
    

</body>
</html>

