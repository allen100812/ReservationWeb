@page
@model Web0524.Pages.Management.PortfolioManagementModel
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="~/js/responsivePaginator.js"></script>
    <style>
        /* 圖片外層容器 */
        .photo-wrapper {
            position: relative;
            display: inline-block;
            margin: 4px;
            width: 300px; /* 原本100，放大3倍 */
            height: 300px;
            overflow: hidden;
        }

            /* 預覽圖片 */
            .photo-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 6px;
                display: block;
            }

            /* 刪除按鈕樣式（叉叉） */
            .photo-wrapper .delete-btn,
            .photo-wrapper .remove-photo-btn,
            .photo-wrapper .remove-upload-photo {
                position: absolute;
                top: 8px; /* 微調位置 */
                right: 8px;
                background-color: rgba(255, 0, 0, 0.8);
                border: none;
                border-radius: 50%;
                color: white;
                width: 30px; /* 放大一點點更好點 */
                height: 30px;
                font-size: 18px;
                line-height: 28px;
                cursor: pointer;
                padding: 0;
                display: flex;
                align-items: center;
                justify-content: center;
            }

        /* 訊息區 */
        #message-area {
            margin-bottom: 1rem;
        }

        /* 響應式切換 */
        @@media (max-width: 768px) {
            .responsive-table {
                display: none;
            }

            .accordion {
                display: block;
            }
        }

        @@media (min-width: 769px) {
            .responsive-table {
                display: block;
            }

            .accordion {
                display: none;
            }
        }
    </style>



</head>
<body>
    @Html.AntiForgeryToken()
    <div class="container " style="margin-top:200px; margin-bottom:200px; ">
        <div id="message-area"></div>
        <h2 class="mb-4 fw-bold">作品集管理</h2>
        

        <form id="portfolioForm" enctype="multipart/form-data">
            <input type="hidden" name="id" id="portfolio-id">
            <input type="hidden" name="preservedPhotoIds" id="preservedPhotoIds">

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">作品集群組</label>
                    <select name="groupId" class="form-select" required>
                        <option value="">-- 選擇群組 --</option>
                        @foreach (var g in Model.AllGroups)
                        {
                            <option value="@g.PortfolioGroup_Id">@g.PortfolioGroup_Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">標題</label>
                    <input type="text" class="form-control" name="title" placeholder="作品標題" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">作品連結</label>
                    <input type="text" class="form-control" name="url" placeholder="作品連結 URL">
                </div>

                <div class="col-md-6">
                    <label class="form-label">上架狀態</label>
                    <select class="form-select" name="isPublished" id="isPublishedSelect">
                        <option value="true">上架</option>
                        <option value="false">未上架</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">作品說明</label>
                    <textarea class="form-control" name="content" rows="4" placeholder="作品說明"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">新增圖片</label>
                    <input type="file" id="photo-upload" name="photos" class="form-control" accept="image/*" multiple>
                    <div class="row mt-3" id="preview-area"></div>
                </div>
                <div class="col-md-12">
                    <div id="existing-images" class="mt-3 row row-cols-2 row-cols-md-4 g-3"></div>
                </div>
                <div class="col-md-12">
                    <button type="submit" class="btn btn-dark">儲存作品</button>
                </div>
            </div>
        </form>
        <hr />
        <h4 class="mt-4">作品群組管理</h4>
        <form id="group-form" class="row g-3 mt-2">
            <div class="col-md-4">
                <input type="text" id="new-group-name" class="form-control" placeholder="群組名稱" />
            </div>
            <div class="col-md-4">
                <input type="text" id="new-group-content" class="form-control" placeholder="群組說明（可選）" />
            </div>
            <div class="col-md-4">
                <button type="button" id="add-group-btn" class="btn btn-dark w-100">新增群組</button>
                <button type="button" id="save-group-btn" class="btn btn-dark d-none">儲存修改</button>
                <button type="button" id="cancel-edit-btn" class="btn btn-outline-dark d-none">取消修改</button>
                <input type="hidden" id="edit-group-id" />
            </div>
        </form>

        <!-- 桌機版群組表格 -->
        <div class="responsive-table mt-4">
            <table id="group-table" class="table table-bordered">
                <!-- thead/tbody 由 JS 自動產生 -->
            </table>
        </div>

        <div class="accordion mt-4" id="group-accordion"></div>


        <div id="group-pagination" class="mt-4"></div>

        <hr />
        <h4 class="mt-4">目前所有作品集</h4>

        <div class="input-group mb-3 mt-2">
            <input type="text" id="portfolio-search" class="form-control" placeholder="輸入關鍵字搜尋標題 / 群組 / 內容">
            <button class="btn btn-dark" type="button" id="clear-search">清除</button>
        </div>


        <div class="responsive-table mt-4">
            <table id="portfolio-table" class="table table-bordered table-hover mt-3">
                <!-- thead 會由 JS 自動建立 -->
            </table>
        </div>


        <div id="portfolio-accordion" class="accordion mt-4"></div>
        <div id="portfolio-pagination" class="mt-4"></div>



        <div id="pagination-container" class="mt-4"></div>






    </div>


    <script>

        function deletePortfolio(id) {
            if (!confirm("確定要刪除此作品？")) return;
            $.ajax({
                url: `?handler=Delete&portfolioId=${id}`,
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                success: function (res) {
                    if (res.success) {
                        showMsg("刪除成功", true);
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showMsg(res.message || "刪除失敗", false);
                    }
                },
                error: function () {
                    showMsg("刪除失敗，請稍後再試。", false);
                }
            });
        }

        $("#add-group-btn").click(function () {
            const name = $("#new-group-name").val().trim();
            const content = $("#new-group-content").val().trim();
            if (!name) return alert("請輸入群組名稱");

            $.ajax({
                url: `?handler=AddGroup&name=${encodeURIComponent(name)}&content=${encodeURIComponent(content)}`,
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                success: function (res) {
                    if (res.success) location.reload();
                    else alert("新增失敗");
                }
            });
        });

        $(document).on("click", ".edit-group-btn", function () {
            const id = $(this).data("id");
            const name = $(this).data("name");
            const content = $(this).data("content");
            $("#edit-group-id").val(id);
            $("#new-group-name").val(name);
            $("#new-group-content").val(content);
            $("#add-group-btn").addClass("d-none");
            $("#save-group-btn, #cancel-edit-btn").removeClass("d-none");
        });


        $("#save-group-btn").click(function () {
            const id = $("#edit-group-id").val();
            const name = $("#new-group-name").val().trim();
            const content = $("#new-group-content").val().trim();
            if (!name) return alert("請輸入群組名稱");

            $.ajax({
                url: `?handler=UpdateGroup&id=${id}&name=${encodeURIComponent(name)}&content=${encodeURIComponent(content)}`,
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                success: function (res) {
                    if (res.success) location.reload();
                    else alert("更新失敗");
                }
            });
        });

        $("#cancel-edit-btn").click(function () {
            $("#edit-group-id").val("");
            $("#new-group-name").val("");
            $("#new-group-content").val("");
            $("#add-group-btn").removeClass("d-none");
            $("#save-group-btn, #cancel-edit-btn").addClass("d-none");
        });

        $(document).on("click", ".delete-group-btn", function () {
            const id = $(this).data("id");
            if (!confirm("確定要刪除此群組？")) return;

            $.ajax({
                url: `?handler=DeleteGroup&id=${id}`,
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                success: function (res) {
                    if (res.success) location.reload();
                    else alert("刪除失敗");
                }
            });
        });
    </script>


    <script>
        let selectedFiles = []; // [{ id, file }]
        let preservedPhotoIds = []; // [int]
        let fileCounter = 0;

        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function showMsg(msg, success = true) {
            const cls = success ? 'success' : 'danger';
            $('#message-area').html(`<div class="alert alert-${cls}">${msg}</div>`);
        }

        function editPortfolio(id) {
            $.ajax({
                url: `?handler=Edit&portfolioId=${id}`,
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                success: function (res) {
                    if (res.success && res.data) {
                        const p = res.data;
                        selectedFiles = [];
                        preservedPhotoIds = [];
                        fileCounter = 0;

                        $("#portfolio-id").val(p.id);
                        $("input[name='title']").val(p.title);
                        $("input[name='url']").val(p.url);
                        $("select[name='groupId']").val(p.groupId);
                        $("textarea[name='content']").val(p.content);
                        $("#isPublished").prop("checked", p.isPublished);
                        $("#existing-images").empty();
                        $("#preview-area").empty();

                        if (p.photoList?.length > 0) {
                            p.photoList.forEach((img) => {
                                preservedPhotoIds.push(img.photoId);
                                $("#existing-images").append(`
                                                        <div class="photo-wrapper" id="photo_${img.photoId}" data-preserved="true">
                                                    <img src="data:image/jpeg;base64,${img.base64}" />
                                                            <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 remove-photo-btn" data-id="${img.photoId}">&times;</button>
                                                </div>`);
                            });
                        }
                        // ✅ 滑動到頁面頂部
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    } else {
                        showMsg("載入失敗", false);
                    }
                },
                error: function () {
                    showMsg("無法載入資料", false);
                }
            });
        }

        $(document).on('change', '#photo-upload', function () {
            const files = this.files;
            if (files.length > 0) {
                Array.from(files).forEach(file => {
                    const reader = new FileReader();
                    const fileId = `file_${fileCounter++}`;
                    reader.onload = function (e) {
                        $('#preview-area').append(`
                                        <div class="photo-wrapper" data-id="${fileId}">
                                            <img src="${e.target.result}" />
                                            <button type="button" class="delete-btn remove-upload-photo" data-id="${fileId}">&times;</button>
                                        </div>`);
                        selectedFiles.push({ id: fileId, file: file });
                    };
                    reader.readAsDataURL(file);
                });
            }
            this.value = null;
        });

        $(document).on('click', '.remove-upload-photo', function () {
            const fileId = $(this).data('id');
            selectedFiles = selectedFiles.filter(f => f.id !== fileId);
            $(this).closest('.photo-wrapper').remove();
        });

        $(document).on('click', '.remove-photo-btn', function () {
            const photoId = $(this).data('id');
            preservedPhotoIds = preservedPhotoIds.filter(id => id !== photoId);
            $(this).closest('.photo-wrapper').remove();
        });

        $('#portfolioForm').submit(function (e) {
            e.preventDefault();
            const formData = new FormData(this);

            // 加入舊圖 ID
            preservedPhotoIds.forEach(id => formData.append("preservedPhotoIds", id));
            // 加入新圖檔
            selectedFiles.forEach(obj => formData.append("photos", obj.file));

            $.ajax({
                url: '?handler=Save',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: { 'RequestVerificationToken': getToken() },
                success: function (res) {
                    showMsg(res.message, res.success);
                    if (res.success) {
                        selectedFiles = [];
                        preservedPhotoIds = [];
                        $('#preview-area').empty();
                        $('#existing-images').empty();
                        $('#portfolioForm')[0].reset();
                        setTimeout(() => location.reload(), 1000);
                    }
                },
                error: function () {
                    showMsg("儲存失敗，請稍後再試。", false);
                }
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const allPortfolios = @Html.Raw(Json.Serialize(Model.AllPortfolios));
            const allGroups = @Html.Raw(Json.Serialize(Model.AllGroups));
            let filteredPortfolios = allPortfolios;

            function renderPortfolioTable() {
                window.initResponsivePaginator({
                    data: filteredPortfolios,
                    tableColumns: [
                        { title: '標題', className: 'text-nowrap', render: row => row.portfolio_Title },
                        { title: '連結', className: 'text-nowrap', render: row => `<a href="${row.portfolio_URL}" target="_blank">連結</a>` },
                        { title: '內容', render: row => row.portfolio_Content },
                        {
                            title: '群組', className: 'text-nowrap', render: row => {
                                const g = allGroups.find(x => x.portfolioGroup_Id === row.portfolioGroup_Id);
                                return g ? g.portfolioGroup_Name : '未知';
                            }
                        },
                        {
                            title: '狀態', className: 'text-nowrap', render: row => row.isPublished
                                ? '<span class="badge bg-success">上架</span>'
                                : '<span class="badge bg-secondary">未上架</span>'
                        }
                    ],
                    tableWrapperId: 'portfolio-table',
                    accordionWrapperId: 'portfolio-accordion',
                    paginationWrapperId: 'portfolio-pagination',
                    pageSize: 10,
                    renderRowButtons: row => `
                                        <button class="btn btn-sm btn-secondary" onclick="editPortfolio(${row.portfolio_Id})">編輯</button>
                                <button class="btn btn-sm btn-danger" onclick="deletePortfolio(${row.portfolio_Id})">刪除</button>`
                });
            }

            // 初始渲染
            renderPortfolioTable();

            // 關鍵字過濾邏輯
            $('#portfolio-search').on('input', function () {
                const keyword = $(this).val().toLowerCase();
                filteredPortfolios = allPortfolios.filter(p => {
                    const group = allGroups.find(g => g.portfolioGroup_Id === p.portfolioGroup_Id);
                    const groupName = group ? group.portfolioGroup_Name : '';
                    return (
                        (p.portfolio_Title || '').toLowerCase().includes(keyword) ||
                        (p.portfolio_Content || '').toLowerCase().includes(keyword) ||
                        (groupName || '').toLowerCase().includes(keyword)
                    );
                });
                renderPortfolioTable();
            });

            $('#clear-search').click(function () {
                $('#portfolio-search').val('');
                filteredPortfolios = allPortfolios;
                renderPortfolioTable();
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // ✅ 作品群組 JS 分頁
            window.initResponsivePaginator({
                data: @Html.Raw(Json.Serialize(Model.AllGroups)),
                tableColumns: [
                    { title: '群組名稱', className: 'text-nowrap', render: row => row.portfolioGroup_Name },
                    { title: '內容', render: row => row.portfolioGroup_Content }
                ],
                tableWrapperId: 'group-table',
                accordionWrapperId: 'group-accordion',
                paginationWrapperId: 'group-pagination',
                pageSize: 10,
                renderRowButtons: row => `
                                <button type="button" class="btn btn-sm btn-secondary edit-group-btn"
                            data-id="${row.portfolioGroup_Id}"
                            data-name="${row.portfolioGroup_Name.replaceAll('"', '&quot;')}"
                            data-content="${row.portfolioGroup_Content.replaceAll('"', '&quot;')}">編輯</button>
                        <button type="button" class="btn btn-sm btn-danger delete-group-btn"
                            data-id="${row.portfolioGroup_Id}">刪除</button>`
            });
        });
    </script>
   
</body>
</html>

