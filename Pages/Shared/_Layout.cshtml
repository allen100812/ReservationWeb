    <script>
        function openMenu() {
            const menu = document.getElementById("sidebar");
            const panel = menu.querySelector(".menu-panel");
            const content = menu.querySelector(".menu-content");

            // 啟動視覺顯示
            menu.classList.add("active");

            // 清除舊狀態
            menu.classList.remove("hide");
            content.classList.remove("fade-in", "move-up", "move-down");

            // 加上展開動畫狀態
            setTimeout(() => {
                menu.classList.add("show");
            }, 10); // 強制觸發 transition

            // 文字淡入
            setTimeout(() => {
                content.classList.add("fade-in");
            }, 300);

            // 文字稍微上浮
            setTimeout(() => {
                content.classList.add("move-up");
            }, 500);
        }

        function closeMenu() {
            const menu = document.getElementById("sidebar");
            const content = menu.querySelector(".menu-content");

            // 先下移文字
            content.classList.remove("move-up");
            content.classList.add("move-down");

            // 加上背景收起動畫
            menu.classList.remove("show");
            menu.classList.add("hide");

            // 文字淡出
            setTimeout(() => {
                content.classList.remove("fade-in");
            }, 300);

            // 等動畫結束再完全關閉
            setTimeout(() => {
                content.classList.remove("move-down");
                menu.classList.remove("hide", "active");
            }, 800);
        }
    </script>

