@page
@model Web0524.Pages.Account.MyCouponsModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["MyName"] | 我的優惠券</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        body {
            background-color: #fff;
            color: #333;
            font-family: 'Segoe UI', 'Noto Sans TC', sans-serif;
        }

        h2 {
            font-weight: 700;
            color: #222;
        }

        .coupon-card {
            border-radius: 12px;
            background: linear-gradient(145deg, #fefefe, #f4f4f4);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            border-left: 6px solid #ffc5c5;
            transition: transform 0.2s;
        }

            .coupon-card:hover {
                transform: scale(1.01);
            }

        .coupon-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: #d44a4a;
        }

        .coupon-content {
            font-size: 0.95rem;
            color: #555;
            margin-bottom: 0.3rem;
        }

        .coupon-meta {
            font-size: 0.85rem;
            color: #999;
        }

        .btn-coupon {
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 500;
            color: #d44a4a;
            border: 1px solid #d44a4a;
            background-color: transparent;
            padding: 6px 16px;
            transition: all 0.3s;
        }

            .btn-coupon:hover {
                background-color: #d44a4a;
                color: white;
            }

        .modal-content {
            background-color: #fff;
            border-radius: 12px;
        }

        .text-muted {
            font-size: 0.8rem;
        }
    </style>
</head>

<body>
    <div class="container py-5">
        <h2 class="text-center mb-4">🎉 我的優惠券</h2>

        @if (Model.DispatchRecords.Any())
        {
            @foreach (var record in Model.DispatchRecords)
            {
                var c = Model.CouponMap.ContainsKey(record.CouponId) ? Model.CouponMap[record.CouponId] : null;
                if (c == null) { continue; }

                <div class="coupon-card">
                    <div class="coupon-title">@c.Title</div>
                    <div class="coupon-content">@c.Remark</div>
                    <div class="coupon-meta">
                        📅 有效期間：@c.ValidFrom:yyyy-MM-dd ~ @c.ValidTo:yyyy-MM-dd <br />
                        💰 最低金額：@c.MinAmount.ToString("C0") <br />
                        🎁 折扣：
                        @if (c.DiscountType == Models.DiscountTypeEnum.FixedAmount)
                        {
                            <span>@c.FixedDiscountAmount?.ToString("C0")</span>
                        }
                        else
                        {
                            <span>@c.DiscountAmount.ToString("0.#")%</span>
                        }
                        <br />
                        備註: @c.Remark
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-coupon generate-qr" data-id="@record.RecordId">
                            使用此券
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center text-muted mt-5">
                <i class="fas fa-info-circle me-2"></i>目前沒有可使用的優惠券
            </div>
        }
    </div>

    <!-- QR Modal -->
    <div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center">
                <div class="modal-header">
                    <h5 class="modal-title">請讓店員掃描此條碼</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="qrcodeArea" class="my-3 d-flex justify-content-center"></div>
                    <small class="text-muted">條碼 1 分鐘內有效，請勿轉傳。</small>
                </div>
            </div>
        </div>
    </div>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.generate-qr').click(function () {
                var recordId = $(this).data('id');
                $.get('?handler=GenerateQR&recordId=' + recordId, function (data) {
                    $('#qrcodeArea').empty();
                    QRCode.toCanvas(document.createElement("canvas"), data.qr, { width: 256 }, function (err, canvas) {
                        if (!err) {
                            $('#qrcodeArea').append(canvas);
                            var modal = new bootstrap.Modal(document.getElementById('qrModal'));
                            modal.show();
                        }
                    });
                });
            });
        });
    </script>
</body>
</html>
