<!-- ✅ 3. JavaScript 動態處理訊息 -->
<script>
    let messages = [];

    function getMessageTypeStyle(type) {
        switch (type) {
            case 1: return "list-group-item-danger"; // 警告
            case 2: return "list-group-item-warning"; // 系統
            case 3: return "list-group-item-info"; // 店鋪
            default: return "list-group-item-light";
        }
    }

    function renderMessages() {
        const list = document.getElementById("messageList");
        list.innerHTML = "";

        if (messages.length === 0) {
            list.innerHTML = '<p class="text-muted">目前沒有新訊息。</p>';
        } else {
            messages.forEach(m => {
                const item = document.createElement("div");
                item.className = `list-group-item ${getMessageTypeStyle(m.messageType)}`;
                item.innerHTML = `
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1">${m.title} ${!m.isRead ? '<span class=\"badge bg-danger ms-2\">新訊息</span>' : ''}</h5>
                            <small class="text-muted">${m.createdAt}</small>
                        </div>
                        <p class="mb-1">${m.content}</p>
                    `;
                list.appendChild(item);
            });
        }
    }

    function openMessageModal() {
        renderMessages();
        const modal = new bootstrap.Modal(document.getElementById('messageModal'));
        modal.show();

        // ⏱️ 等待 3 秒標記已讀
        setTimeout(() => markAllAsRead(), 3000);
    }

    function markAllAsRead() {
        fetch('/api/Message/MarkAllMessagesRead', {
            method: 'POST'
        }).then(() => {
            messages.forEach(m => m.isRead = true);
            document.getElementById("messageBadge").classList.add("d-none");
            renderMessages();
        });
    }

    function loadMessages() {
        fetch('/api/Message/GetUserMessages')
            .then(res => res.json())
            .then(data => {
                // 若回傳是物件包陣列，如 { result: [...] }
                if (Array.isArray(data)) {
                    messages = data;
                } else if (data && Array.isArray(data.result)) {
                    messages = data.result;
                } else {
                    messages = [];
                }

                const unreadCount = messages.filter(m => !m.isRead).length;
            });
    }

    document.addEventListener("DOMContentLoaded", loadMessages);
</script>
@await RenderSectionAsync("Scripts", required: false)
