@page
@model Web0524.Pages.Management.DesignerManagementModel
@{
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>設計師管理</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            color: #212529;
            font-family: 'Segoe UI', sans-serif;
        }

        h2 {
            margin-bottom: 30px;
            font-weight: 600;
            color: #333;
        }

        .form-control, .form-select {
            background-color: #fff;
            border-color: #ced4da;
            color: #333;
        }

        .btn-success, .btn-danger, .btn-primary, .btn-secondary {
            background-color: #333;
            border-color: #333;
            color: #fff;
        }

            .btn-success:hover,
            .btn-danger:hover,
            .btn-primary:hover,
            .btn-secondary:hover {
                background-color: #555;
                border-color: #555;
            }

        .container {
            padding-top: 60px;
            padding-bottom: 60px;
        }

        .list-group-item {
            background-color: #fff;
            border-color: #ddd;
        }

        .inactive-label {
            font-size: 0.85rem;
            color: #999;
            margin-left: 6px;
        }
    </style>
</head>
<body>
    <div class="container">

        <h2>設計師管理</h2>

        <form method="post" class="mb-4">
            <div class="row g-2">
                <div class="col-md-4">
                    <input asp-for="NewDesigner.Name" class="form-control" placeholder="設計師姓名" required />
                </div>
                <div class="col-md-4">
                    <input asp-for="NewDesigner.Nickname" class="form-control" placeholder="暱稱" />
                </div>
                <div class="col-md-4">
                    <button type="submit" name="action" value="add" class="btn btn-success w-100">新增設計師</button>
                </div>
            </div>
        </form>

        @if (Model.AllDesigners.Any())
        {
            @foreach (var d in Model.AllDesigners)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-3">
                                <strong>姓名：</strong>@d.Name
                                @if (!d.IsDeleted)
                                {
                                    <span class="inactive-label">(已停用)</span>
                                }
                            </div>
                            <div class="col-md-3"><strong>暱稱：</strong>@d.Nickname</div>
                            <div class="col-md-3"><strong>ID：</strong>@d.DesignerId</div>
                            <div class="col-md-3 text-end">
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="DesignerId" value="@d.DesignerId" />
                                    @if (d.IsDeleted)
                                    {
                                        <button type="submit" name="action" value="deactivate" class="btn btn-sm btn-danger">停用</button>
                                    }
                                    else
                                    {
                                        <button type="submit" name="action" value="activate" class="btn btn-sm btn-secondary">啟用</button>
                                    }
                                </form>
                            </div>
                        </div>

                        <hr />

                        <h6 class="mt-3">排程規則</h6>
                        @if (d.ScheduleRules.Any())
                        {
                            <ul class="list-group mb-3">
                                @foreach (var rule in d.ScheduleRules)
                                {
                                    var product = Model.AllProducts.FirstOrDefault(p => p.ProductId == rule.ProductId);
                                    string productName = product != null ? product.Name : "未知產品";
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>產品：</strong>@rule.ProductId / @productName，
                                            <strong>耗時：</strong>@rule.DurationMinutes 分鐘，
                                            <strong>最大人數：</strong>@rule.MaxCustomers 人
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">尚未設定規則</p>
                        }

                        <form method="post" class="row g-2 align-items-end">
                            <input type="hidden" name="DesignerId" value="@d.DesignerId" />
                            <div class="col-md-3">
                                <select name="NewRule.ProductId" class="form-select" required>
                                    <option value="">請選擇產品</option>
                                    @foreach (var p in Model.AllProducts)
                                    {
                                        <option value="@p.ProductId">@p.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <input type="number" name="NewRule.DurationMinutes" class="form-control" placeholder="耗時（分鐘）" required />
                            </div>
                            <div class="col-md-3">
                                <input type="number" name="NewRule.MaxCustomers" class="form-control" placeholder="最大人數" required />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" name="action" value="addrule" class="btn btn-primary w-100 btn-sm">新增排程規則</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info mt-4">@Model.Message</div>
        }

    </div>
</body>
</html>
