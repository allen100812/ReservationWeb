@page
@model Web0524.Pages.Management.MyManagementModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet" media="all">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <script src="~/js/responsivePaginator.js"></script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    @Html.AntiForgeryToken()

    <div class="container" style="margin-top:200px; margin-bottom:200px; ">

<h2>編輯基本設定</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

<form method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="MyData.Name" class="form-label">公司全名</label>
        <input asp-for="MyData.Name" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="MyData.Name_short" class="form-label">公司簡稱</label>
        <input asp-for="MyData.Name_short" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="MyData.Phone" class="form-label">電話</label>
        <input asp-for="MyData.Phone" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="MyData.Email" class="form-label">Email</label>
        <input asp-for="MyData.Email" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="MyData.Line" class="form-label">Line ID</label>
        <input asp-for="MyData.Line" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="MyData.WebURL" class="form-label">網站連結</label>
        <input asp-for="MyData.WebURL" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="MyData.Fb_Url" class="form-label">Facebook 連結</label>
        <input asp-for="MyData.Fb_Url" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="MyData.Ig_Url" class="form-label">Instagram 連結</label>
        <input asp-for="MyData.Ig_Url" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="MyData.Yt_Url" class="form-label">YouTube 連結</label>
        <input asp-for="MyData.Yt_Url" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="MyData.Tk_Url" class="form-label">TikTok 連結</label>
        <input asp-for="MyData.Tk_Url" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="MyData.LineBotURL" class="form-label">Line Bot 回傳網址</label>
        <input asp-for="MyData.LineBotURL" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="MyData.Line_Url" class="form-label">Line 加好友網址</label>
        <input asp-for="MyData.Line_Url" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="MyData.Max_Order_Oneday" class="form-label">每日最大訂單數</label>
        <input asp-for="MyData.Max_Order_Oneday" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="MyData.Max_Reg_Oneday" class="form-label">每日最大註冊數</label>
        <input asp-for="MyData.Max_Reg_Oneday" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="MyData.CancelLimitHours" class="form-label">取消限制（小時）</label>
        <input asp-for="MyData.CancelLimitHours" class="form-control" />
    </div>
    <div class="col-md-6 form-check form-switch">
        <input asp-for="MyData.CreateOrderSandLineMsgSw" class="form-check-input" />
        <label asp-for="MyData.CreateOrderSandLineMsgSw" class="form-check-label">開啟建立訂單訊息通知</label>
    </div>
    <div class="col-md-6 form-check form-switch">
        <input asp-for="MyData.CancelSandLineMsgSw" class="form-check-input" />
        <label asp-for="MyData.CancelSandLineMsgSw" class="form-check-label">開啟取消訂單訊息通知</label>
    </div>

    <div class="col-md-12">
        <label asp-for="MyData.Msg_BindOk" class="form-label">綁定完成訊息</label>
        <textarea asp-for="MyData.Msg_BindOk" class="form-control" rows="2"></textarea>
    </div>

    <div class="col-12 mt-4">
        <button type="submit" class="btn btn-primary">儲存變更</button>
    </div>
</form>

    </div>

</body>
</html>
