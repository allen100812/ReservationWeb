@page
@model Web0524.Pages.ReportModel

<!DOCTYPE html>
<meta charset="utf-8">
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet" media="all">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://unpkg.com/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script src="https://unpkg.com/jspdf-autotable@3.5.28/dist/jspdf.plugin.autotable.min.js"></script>
    <script src="https://unpkg.com/jspdf@2.5.1/dist/fonts/NotoSansTC-Regular-normal.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>


    <title>美容工作室介紹</title>
</head>
<body>
    <div class="container" style="margin-top:200px; margin-bottom:200px; ">
        @Html.AntiForgeryToken()
        <h2 class="mb-4 fw-bold">報表查詢系統</h2>
        <div class="mb-3">
            <label for="reportType" class="form-label">選擇報表</label>
            <select id="reportType" class="form-select">
                <option value="">請選擇</option>
                <option value="reservationSummary">總預約統計</option>
                <option value="designerStats">設計師接單報表</option>
                <option value="peakHour">高峰時段分析</option>
                <option value="revenue">營收統計</option>
                <option value="designerRevenue">設計師營收報表</option>
                <option value="paymentMethod">支付方式分析</option>
                <option value="memberActivity">會員活躍度分析</option>
                <option value="pointUsage">點數使用分析</option>
                <option value="topMember">高貢獻會員排行</option>
                <option value="couponUsage">優惠券使用分析</option>
                <option value="reservationDetail">預約明細匯出</option>
            </select>
        </div>

        <div id="parameterSection">
            <div class="mb-3">
                <label for="startDate" class="form-label">起始日期</label>
                <input type="date" id="startDate" class="form-control">
            </div>
            <div class="mb-3">
                <label for="endDate" class="form-label">結束日期</label>
                <input type="date" id="endDate" class="form-control">
            </div>
            <div class="mb-3 d-none" id="designerFilter">
                <label for="designerId" class="form-label">設計師 ID</label>
                <input type="number" id="designerId" class="form-control">
            </div>
            <div class="mb-3 d-none" id="topNFilter">
                <label for="topN" class="form-label">前 N 名</label>
                <input type="number" id="topN" class="form-control" value="20">
            </div>
        </div>

        <div class="mb-3">
            <button id="submitBtn" class="btn btn-dark">查詢報表</button>
            <button id="exportExcel" class="btn btn-secondary ms-2">匯出 Excel</button>
            <button id="exportPdf" class="btn btn-secondary ms-2">匯出 PDF</button>
        </div>

        <div id="reportHeader" class="my-4"></div>
        <div id="reportResult"></div>
    </div>



    <script>
        const username = "@(User.Identity?.Name ?? "匿名使用者")";
        const today = "@Model.Today";
        const fieldNameMap = {
            reservationSummary: {
                date: "日期",
                totalReservations: "總預約數",
                completedCount: "完成數",
                cancelledCount: "取消數"
            },
            designerStats: {
                designerId: "設計師ID",
                designerName: "設計師名稱",
                totalReservations: "總預約數",
                completed: "完成數",
                cancelled: "取消數"
            },
            peakHour: {
                hour: "時段",
                reservationCount: "預約數"
            },
            revenue: {
                date: "日期",
                totalRevenue: "總營收",
                discountAmount: "折扣金額"
            },
            designerRevenue: {
                designerId: "設計師ID",
                designerName: "設計師名稱",
                totalRevenue: "總營收"
            },
            paymentMethod: {
                paymentMethod: "支付方式",
                count: "筆數",
                totalAmount: "總金額"
            },
            memberActivity: {
                memberId: "會員ID",
                memberName: "會員名稱",
                reservationCount: "預約數",
                lastReservationDate: "最近預約日期"
            },
            pointUsage: {
                memberId: "會員ID",
                pointsEarned: "獲得點數",
                pointsUsed: "使用點數"
            },
            topMember: {
                memberId: "會員ID",
                memberName: "會員名稱",
                totalSpent: "總消費",
                reservationCount: "預約數"
            },
            couponUsage: {
                couponId: "優惠券ID",
                title: "名稱",
                usageCount: "使用次數",
                totalDiscountAmount: "折扣總金額"
            },
            reservationDetail: {
                orderId: "訂單ID",
                reservationDateTime: "預約時間",
                designerName: "設計師名稱",
                memberName: "會員名稱",
                serviceName: "服務項目",
                price: "價格",
                status: "狀態"
            }
        };




        document.getElementById("submitBtn").addEventListener("click", async () => {
            const reportType = $("#reportType").val();
            const startDate = $("#startDate").val();
            const endDate = $("#endDate").val();
            const designerId = $("#designerId").val();
            const topN = $("#topN").val();
            const token = $('input[name="__RequestVerificationToken"]').val();

            const payload = new URLSearchParams({
                ReportType: reportType,
                StartDate: startDate,
                EndDate: endDate,
                DesignerId: designerId || "",
                TopN: topN || "20"
            });

            const response = await fetch("?handler=Ajax", {
                method: "POST",
                headers: {
                    "RequestVerificationToken": token,
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: payload
            });

            const result = await response.json();
            if (response.ok) {
                renderFullTable(result);

            } else {
                alert("查詢失敗");
            }
        });



        function renderHeader(type) {
            const nameMap = {
                reservationSummary: "總預約統計",
                designerStats: "設計師接單報表",
                peakHour: "高峰時段分析",
                revenue: "營收統計",
                designerRevenue: "設計師營收報表",
                paymentMethod: "支付方式分析",
                memberActivity: "會員活躍度分析",
                pointUsage: "點數使用分析",
                topMember: "高貢獻會員排行",
                couponUsage: "優惠券使用分析",
                reservationDetail: "預約明細匯出"
            };
            const header = `<h5>報表名稱：${nameMap[type] || "未知報表"}</h5>
                               <p>製表人：${username}</p>
                               <p>製表時間：${today}</p>`;
            $("#reportHeader").html(header);
        }
        function renderFullTable(data) {
            const container = document.getElementById("reportResult");
            if (!data || data.length === 0) {
                container.innerHTML = "<div class='mt-4 alert alert-info'>查無資料</div>";
                return;
            }

            const reportType = $("#reportType").val();
            const map = fieldNameMap[reportType] || {};
            const keys = Object.keys(data[0]);

            let html = "<table id='reportTable' class='table table-bordered'>";

            // 第一行：報表名稱
            html += `<thead><tr><th colspan="${keys.length}" class="text-center fs-5 bg-secondary text-white">${$("#reportType option:selected").text()}</th></tr>`;

            // 第二行：製表人與製表時間
            html += `<tr><th colspan="${keys.length}" class="text-start small">製表人：${username}　　製表時間：${today}</th></tr>`;

            // 第三行：欄位名稱
            html += "<tr>" + keys.map(k => `<th>${map[k] || k}</th>`).join('') + "</tr></thead><tbody>";

            data.forEach(row => {
                html += "<tr>" + keys.map(k => `<td>${formatCell(row[k])}</td>`).join('') + "</tr>";
            });

            html += "</tbody></table>";
            container.innerHTML = html;
        }


        function formatCell(value) {
            if (value === null || value === undefined) return "";
            if (typeof value === "string" && value.includes("T")) {
                const [date, time] = value.split("T");
                return `${date} ${time.split(".")[0]}`; // 2025-06-24 17:36:25
            }
            return value;
        }
        function renderTable(data) {
            const container = document.getElementById("reportResult");
            if (!data || data.length === 0) {
                container.innerHTML = "<div class='mt-4 alert alert-info'>查無資料</div>";
                return;
            }

            const reportType = $("#reportType").val();
            const map = fieldNameMap[reportType] || {};
            const keys = Object.keys(data[0]); // 使用資料實際欄位順序

            let html = "<table id='reportTable' class='table table-bordered'><thead><tr>";
            html += keys.map(k => `<th>${map[k] || k}</th>`).join('');
            html += "</tr></thead><tbody>";

            data.forEach(row => {
                html += "<tr>" + keys.map(k => `<td>${row[k]}</td>`).join('') + "</tr>";
            });

            html += "</tbody></table>";
            container.innerHTML = html;
        }


        function formatCell(value) {
            if (value === null || value === undefined) return "";
            if (typeof value === "string" && value.includes("T")) {
                const [date, time] = value.split("T");
                return `${date} ${time.split(".")[0]}`; // 2025-06-24 17:36:25
            }
            return value;
        }


        document.getElementById("exportExcel").addEventListener("click", () => {
            const wb = XLSX.utils.table_to_book(document.getElementById("reportTable"));
            XLSX.writeFile(wb, "報表.xlsx");
        });

        document.getElementById("exportPdf").addEventListener("click", () => {
            const element = document.getElementById("reportResult"); // 可以包含報表標題與表格
            const opt = {
                margin: 0.5,
                filename: '報表.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save();
        });



    </script>

</body>
</html>
