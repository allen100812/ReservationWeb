@page
@model Web0524.Pages.MyReservationsModel
@{
    ViewData["Title"] = "我的預約紀錄";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>我的預約紀錄</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <div class="container mt-5">
        <h2 class="text-center mb-4">我的預約紀錄</h2>

        <form method="get" class="row g-3 mb-4">
            <div class="col-md-3">
                <label class="form-label">預約日期</label>
                <input type="date" class="form-control" name="FilterDate" value="@Model.FilterDate?.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-3">
                <label class="form-label">設計師</label>
                <select class="form-select" name="FilterDesignerId">
                    <option value="">全部</option>
                    @foreach (var d in Model.AllDesigners)
                    {
                        <option value="@d.DesignerId" selected="@(Model.FilterDesignerId == d.DesignerId ? "selected" : null)">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">服務名稱</label>
                <input type="text" class="form-control" name="FilterProductName" value="@Model.FilterProductName">
            </div>
            <div class="col-md-3">
                <label class="form-label">狀態</label>
                <select class="form-select" name="FilterStatus">
                    <option value="">全部</option>
                    @foreach (Models.OrderStatus status in Enum.GetValues(typeof(Models.OrderStatus)))
                    {
                        <option value="@status" selected="@(Model.FilterStatus == status ? "selected" : null)">
                            @(status switch
                            {
                                Models.OrderStatus.Pending => "未處理",
                                Models.OrderStatus.Completed => "已完成",
                                Models.OrderStatus.Cancelled => "已取消",
                                _ => status.ToString()
                            })
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 text-end">
                <button type="submit" class="btn btn-primary">查詢</button>
            </div>
        </form>

        @if (Model.MyOrders.Any())
        {
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>日期</th>
                        <th>時間</th>
                        <th>設計師</th>
                        <th>服務項目</th>
                        <th>狀態</th>
                        <th>備註</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.MyOrders)
                    {
                        <tr>
                            <td>@order.ReservationDateTime.ToString("yyyy-MM-dd")</td>
                            <td>@order.ReservationDateTime.ToString("HH:mm")</td>
                            <td>@Model.GetDesignerName(order.DesignerId)</td>
                            <td>@Model.GetProductName(order.ProductId)</td>
                            <td>
                                @switch (order.Status)
                                {
                                    case Models.OrderStatus.Pending:
                                        <span class="text-warning">⏳ 未處理</span>
                                        ; break;
                                    case Models.OrderStatus.Completed:
                                        <span class="text-success">✅ 已完成</span>
                                        ; break;
                                    case Models.OrderStatus.Cancelled:
                                        <span class="text-danger">❌ 已取消</span>
                                        ; break;
                                }
                            </td>
                            <td>@order.Remark</td>
                            <td>
                                @if (order.Status == Models.OrderStatus.Pending && (order.ReservationDateTime - DateTime.Now).TotalHours >= 2)
                                {
                                    <form method="post" asp-page-handler="Cancel" asp-route-id="@order.OrderId" onsubmit="return confirm('確定要取消此預約嗎？')">
                                        <button class="btn btn-sm btn-danger">取消</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info text-center">目前沒有任何預約紀錄。</div>
        }
    </div>
</body>
</html>
