@page
@model Web0524.Pages.Management.NewsManagementModel
@{
    ViewData["Title"] = "新聞管理";
    var tags = Enum.GetValues(typeof(Models.NewsTag)).Cast<Models.NewsTag>().ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>

    <div class="container" style="margin-top:200px;">
        @Html.AntiForgeryToken()
        <div class="container" style="margin-top:200px;">
            <h2 class="mb-4">新聞管理</h2>

            <div id="message-area"></div>

            <form id="newsForm" enctype="multipart/form-data">
                <input type="hidden" asp-for="NewItem.NewId" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="NewItem.Title" class="form-label"></label>
                        <input asp-for="NewItem.Title" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NewItem.Author" class="form-label"></label>
                        <input asp-for="NewItem.Author" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="NewItem.Content" class="form-label"></label>
                    <textarea asp-for="NewItem.Content" class="form-control" rows="5"></textarea>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="NewItem.PublishDate" class="form-label"></label>
                        <input asp-for="NewItem.PublishDate" class="form-control" type="datetime-local" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NewItem.Status" class="form-label"></label>
                        <select asp-for="NewItem.Status" class="form-select">
                            <option value="0">草稿</option>
                            <option value="1">已發布</option>
                            <option value="2">下架</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NewItem.Tag" class="form-label">標籤</label>
                        <select asp-for="NewItem.Tag" class="form-select">
                            <option value="">-- 請選擇標籤 --</option>
                            @foreach (var tag in tags)
                            {
                                <option value="@((int)tag)" selected="@(Model.NewItem.Tag == (int)tag)">@tag</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="NewItem.Photos" class="form-label">上傳圖片</label>
                    <input asp-for="NewItem.Photos" type="file" class="form-control" multiple />

                    <div id="existing-images" class="mt-3 row row-cols-2 row-cols-md-4 g-3">
                        @if (Model.NewItem.PhotoList?.Any() == true)
                        {
                            for (int i = 0; i < Model.NewItem.PhotoList.Count; i++)
                            {
                                var base64 = Convert.ToBase64String(Model.NewItem.PhotoList[i]);
                                var imgSrc = $"data:image/jpeg;base64,{base64}";
                                <div class="position-relative col">
                                    <img src="@imgSrc" class="img-thumbnail w-100" />
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 remove-photo-btn" data-index="@i" title="刪除圖片">✕</button>
                                </div>
                            }
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">儲存新聞</button>
            </form>

            <hr />

            <form method="get">
                <div class="row mb-3">
                    <div class="col-md-10">
                        <input type="text" name="keyword" placeholder="搜尋標題" class="form-control" value="@Request.Query["keyword"]" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-secondary w-100">查詢</button>
                    </div>
                </div>
            </form>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>標題</th>
                        <th>作者</th>
                        <th>狀態</th>
                        <th>發布時間</th>
                        <th>置頂</th>
                        <th>標籤</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.NewsList)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.Author</td>
                            <td>
                                @if (item.Status == 0)
                                {
                                    <span class="text-muted">草稿</span>
                                }
                                else if (item.Status == 1)
                                {
                                    <span class="text-success">已發布</span>
                                }
                                else
                                {
                                    <span class="text-danger">下架</span>
                                }
                            </td>
                            <td>@item.PublishDate?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (item.TopTime != null)
                                {
                                    <span class="badge bg-warning text-dark">置頂</span>

                                    <br />
                                    <small>@item.TopTime?.ToString("MM-dd HH:mm")</small>
                                }
                            </td>
                            <td><span class="badge bg-info">@((Web0524.Models.NewsTag?)item.Tag)</span></td>
                            <td>
                                <button class="btn btn-sm btn-warning edit-btn" data-id="@item.NewId">編輯</button>
                                <button class="btn btn-sm btn-danger delete-btn" data-id="@item.NewId">下架</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <script>
    function getToken() {
        return $('input[name="__RequestVerificationToken"]').val();
    }

    // 儲存新聞（含上傳圖片）
    $("#newsForm").submit(function (e) {
        e.preventDefault();
        let formData = new FormData(this);

        // 把被移除的圖片 index 收集下來傳送（若你未實作刪除同步可忽略這段）
        $(".remove-photo-btn").each(function () {
            let index = $(this).data("index");
            formData.append("RemovedPhotoIndexes", index); // 自訂欄位，後端可取用
        });

        $.ajax({
            url: '?handler=Save',
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: {
                'RequestVerificationToken': getToken()
            },
            success: function (res) {
                $("#message-area").html(`<div class="alert alert-success">${res.message}</div>`);
                setTimeout(() => location.reload(), 1000);
            },
            error: function () {
                $("#message-area").html(`<div class="alert alert-danger">儲存失敗，請再試一次。</div>`);
            }
        });
    });

    // 點擊下架按鈕
    $(".delete-btn").click(function () {
        if (!confirm("確認下架？")) return;
        const id = $(this).data("id");
        $.ajax({
            url: `?handler=ToggleStatus&id=${id}&status=2`,
            method: 'POST',
            headers: {
                'RequestVerificationToken': getToken()
            },
            success: function (res) {
                $("#message-area").html(`<div class="alert alert-warning">${res.message}</div>`);
                setTimeout(() => location.reload(), 1000);
            },
            error: function () {
                $("#message-area").html(`<div class="alert alert-danger">下架失敗</div>`);
            }
        });
    });

    // 點擊編輯按鈕，帶出資料與圖片
    $(".edit-btn").click(function () {
        const id = $(this).data("id");
        $.ajax({
            url: `?handler=Edit&id=${id}`,
            method: 'POST',
            headers: {
                'RequestVerificationToken': getToken()
            },
            success: function (res) {
                if (res.success && res.data) {
                    const n = res.data;
                    $("#NewItem_NewId").val(n.newId);
                    $("#NewItem_Title").val(n.title);
                    $("#NewItem_Author").val(n.author);
                    $("#NewItem_Content").val(n.content);
                    $("#NewItem_PublishDate").val(n.publishDate);
                    $("#NewItem_Status").val(n.status);
                    $("#NewItem_Tag").val(n.tag);

                    // 清空原圖片預覽區
                    $("#existing-images").empty();

                    // 將圖片重新加入預覽區
                    if (n.photoList && n.photoList.length > 0) {
                        n.photoList.forEach((b64, i) => {
                            let imgBlock = `
                                <div class="position-relative col">
                                    <img src="data:image/jpeg;base64,${b64}" class="img-thumbnail w-100" />
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 remove-photo-btn" data-index="${i}" title="刪除圖片">✕</button>
                                </div>`;
                            $("#existing-images").append(imgBlock);
                        });
                    }
                } else {
                    showMsg("讀取失敗", false);
                }
            },
            error: function () {
                showMsg("編輯載入失敗", false);
            }
        });
    });

    // 點擊 ✕ 按鈕移除圖片（僅畫面上消失）
    $(document).on('click', '.remove-photo-btn', function () {
        $(this).closest('.col').remove();
    });

    function showMsg(msg, success) {
        const cls = success ? 'success' : 'danger';
        $('#message-area').html(`<div class="alert alert-${cls}">${msg}</div>`);
    }
</script>

        </div>

    </body>
</html>
