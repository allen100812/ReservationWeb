@page
@model Web0524.Pages.Management.DesignerShiftManagementModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>

    <div class="container" style="margin-top:200px;">

        <h2 class="mb-4">設計師排班管理</h2>

        <form method="post">
            <div class="mb-3">
                <label class="form-label">選擇設計師</label>
                <select name="SelectedDesignerId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- 請選擇設計師 --</option>
                    @foreach (var d in Model.AllDesigners)
                    {
                        <option value="@d.DesignerId" selected="@(d.DesignerId == Model.SelectedDesignerId)"> @d.Name</option>

                    }
                </select>
            </div>
        </form>

        @if (Model.SelectedDesigner != null)
        {
            <hr />
            <h5>固定休假設定（每週）</h5>
            <form method="post" asp-page-handler="UpdateFixedHolidays">
                <input type="hidden" name="DesignerId" value="@Model.SelectedDesigner.DesignerId" />
                <div class="row mb-3">
                    @{
                        var days = new[] { "星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六" };
                        for (int i = 0; i < 7; i++)
                        {
                            <div class="col-md-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="FixedHolidays" value="@i" @(Model.SelectedDesigner.FixedHolidays.Contains(i.ToString()) ? "checked" : "") />
                                    <label class="form-check-label">@days[i]</label>
                                </div>
                            </div>
                        }
                    }
                </div>
                <button type="submit" class="btn btn-primary">儲存固定休假</button>
            </form>

            <hr />
            <h5 class="mt-4">指定日期排休</h5>
            <form method="post" asp-page-handler="AddDayOff" class="row g-2 align-items-end mb-4">
                <input type="hidden" name="DesignerId" value="@Model.SelectedDesigner.DesignerId" />
                <div class="col-md-4">
                    <label class="form-label">新增排休日期</label>
                    <input type="date" name="ShiftDate" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-danger">新增排休</button>
                </div>
            </form>

            @if (Model.DayOffList.Any())
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>排休日期</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.DayOffList)
                        {
                            <tr>
                                <td>@s.ShiftDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <form method="post" asp-page-handler="RemoveDayOff">
                                        <input type="hidden" name="DesignerId" value="@Model.SelectedDesigner.DesignerId" />
                                        <input type="hidden" name="ShiftDate" value="@s.ShiftDate.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">移除</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">目前沒有指定日期排休。</p>
            }
        }
    </div>
</body>
</html>







