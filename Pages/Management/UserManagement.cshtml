@page
@model Web0524.Pages.Management.UserManagementModel
@{
    ViewData["Title"] = "用戶管理";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet" media="all">
    <link href="css/hover-min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/Share.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="container" style="margin-top:200px;">
        <h2 class="mb-4">用戶管理</h2>

        <div class="mb-3 row">
            <label for="keyword" class="col-sm-2 col-form-label">關鍵字查詢</label>
            <div class="col-sm-6">
                <input type="text" id="keyword" class="form-control" placeholder="輸入姓名、Email、電話...">
            </div>
            <div class="col-sm-4">
                <button class="btn btn-primary" onclick="loadUsers()">查詢</button>
            </div>
        </div>

        <div id="message-area"></div>

        <table class="table table-bordered mt-4">
            <thead>
                <tr>
                    <th>帳號</th>
                    <th>姓名</th>
                    <th>Email</th>
                    <th>電話</th>
                    <th>訂單數</th>
                    <th>取消數</th>
                    <th>角色</th>
                    <th>權限</th>
                    <th>來源</th>
                    <th>停權</th>
                    <th>備註</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
            </tbody>
        </table>
    </div>

    <script>
        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function loadUsers() {
            const keyword = $('#keyword').val();
            $.ajax({
                url: '/Management/UserManagement?handler=List',
                method: 'GET',
                data: { keyword },
                headers: {
                    'RequestVerificationToken': getToken()
                },
                success: function (data) {
                    const tbody = $('#userTableBody');
                    tbody.empty();
                    data.forEach(u => {
                        tbody.append(`
                                    <tr>
                                        <td>${u.id}</td>
                                        <td>${u.name}</td>
                                        <td>${u.email}</td>
                                        <td>${u.phone}</td>
                                        <td>${u.orderNum}</td>
                                        <td>${u.cancelNum}</td>
                                        <td>${u.role}</td>
                                        <td>${u.permission}</td>
                                        <td>${u.userType}</td>
                                        <td>${u.isDeleted ? '是' : '否'}</td>
                                        <td><input class="form-control form-control-sm" value="${u.remark}" onchange="updateRemark('${u.id}', this.value)"></td>
                                        <td>
                                            <button class="btn btn-sm btn-secondary" onclick="resetPassword('${u.id}')">改密碼</button>
                                            <button class="btn btn-sm btn-danger" onclick="disableUser('${u.id}')">停權</button>
                                        </td>
                                    </tr>
                                `);
                    });
                },
                error: function () {
                    showMsg('讀取用戶失敗', false);
                }
            });
        }

        function updateRemark(id, remark) {
            $.ajax({
                url: '/Management/UserManagement?handler=UpdateRemark',
                method: 'POST',
                data: { id, remark },
                headers: {
                    'RequestVerificationToken': getToken()
                },
                success: res => showMsg(res.message, res.success),
                error: () => showMsg('更新備註失敗', false)
            });
        }

        function resetPassword(id) {
            const pwd = prompt("輸入新密碼 (至少8位英數混合):");
            if (!pwd || pwd.length < 8) return;

            $.ajax({
                url: '/Management/UserManagement?handler=ResetPassword',
                method: 'POST',
                data: { id, pwd },
                headers: {
                    'RequestVerificationToken': getToken()
                },
                success: res => showMsg(res.message, res.success),
                error: () => showMsg('密碼更新失敗', false)
            });
        }

        function disableUser(id) {
            if (!confirm("確認停權此用戶？")) return;

            $.ajax({
                url: '/Management/UserManagement?handler=DisableUser',
                method: 'POST',
                data: { id },
                headers: {
                    'RequestVerificationToken': getToken()
                },
                success: res => showMsg(res.message, res.success),
                error: () => showMsg('停權失敗', false)
            });
        }

        function showMsg(msg, success) {
            const cls = success ? 'success' : 'danger';
            $('#message-area').html(`<div class="alert alert-${cls}">${msg}</div>`);
        }

        $(document).ready(loadUsers);
    </script>


</body>
</html>
